  scope        String
  path         String
  content      String
  revision     Int              @default(1)
  /// A wiki page's title without case or accents; unique per space among wiki pages (a partial index).
  slug         String?
  /// Keyed word tokens of a wiki page's text, so encrypted pages can be searched.
  searchTokens Int[]            @default([])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  revisions    MemoryRevision[]

  @@unique([spaceId, scope, botId, path])
  @@index([spaceId, userId])
  @@index([searchTokens], type: Gin)
