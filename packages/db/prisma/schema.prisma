  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  botId     String
  seq       Int
  type      String
  payload   Json
  runId     String?
  createdAt DateTime @default(now())

  @@unique([threadId, seq])
  @@index([spaceId, createdAt])
  @@index([threadId, seq])
  @@index([runId, type, seq])
  @@map("events")
}

model Task {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  prompt    String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      Run[]

  @@index([spaceId, botId])
  @@map("tasks")
}

model Run {
  id                   String            @id @default(cuid())
  spaceId              String
  space                Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                String
  bot                  Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  threadId             String
  thread               Thread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  taskId               String
  task                 Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId               String
  status               String
  trigger              String
  modelProvider        String?
  modelId              String?
  thinkingLevel        String?
  // True when these columns are the model the run must keep. A later attempt
  // may record the model it used in the same columns without setting this.
  modelPinned          Boolean           @default(false)
  error                String?
  // Set when a rule of the app or a run guard ended the run on purpose (RUN_STOP_REASONS); null otherwise.
  stopReason           String?
  leaseOwner           String?
  leaseFence           Int               @default(0)
  leaseExpiresAt       DateTime?
  checkpoint           String?
  clientNonce          String?
  sourceMessageId      String?
  sourceMessage        Message?          @relation("RunSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  routineId            String?
  routine              Routine?          @relation(fields: [routineId], references: [id], onDelete: SetNull)
  // The failed routine run this run retries. Unique, so a run is retried at most once.
  retryOfRunId         String?           @unique
  // The workflow step this run carries out, and the completed run whose answer it continues.
  // stepOfRunId is unique, so a step runs at most once for each run before it.
  routineStepId        String?
  stepOfRunId          String?           @unique
  /// Set while a voice note is being transcribed; the reconciler leaves the queued run alone.
  awaitingAudioAt      DateTime?
  // Durable retry schedule; null means runnable immediately when queued.
  wakeAt               DateTime?
  // Server-side first visible output, preserved across attempts and resumes.
  firstResponseAt      DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  botOutcomeReturnedAt DateTime?
  // The ticket a run was woken to work on; null for every other run. Its moves follow the run.
  ticketId             String?
  messagingMirroredAt  DateTime?
  teamChatMirroredAt   DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  attempts             Attempt[]
  effects              ExternalEffect[]
  steeringMessages     SteeringMessage[]
  externalMessage      ExternalMessage?

  @@unique([spaceId, clientNonce])
  @@index([status, wakeAt])
  @@index([status, leaseExpiresAt])
  @@index([status, updatedAt, id])
  @@index([botOutcomeReturnedAt, status])
  @@index([trigger, status, messagingMirroredAt, updatedAt])
  @@index([trigger, status, teamChatMirroredAt, updatedAt])
  @@index([spaceId, botId])
  @@index([botId])
  @@index([taskId])
  @@index([sourceMessageId])
  @@index([threadId, status, createdAt])
  // Partial index runs_recent_activity_idx (recent foreground activity) is created in SQL.
  @@index([routineId])
  @@map("runs")
}

model SteeringMessage {
  id            String    @id @default(cuid())
  messageId     String
  message       Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  botId         String
  bot           Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId        String
  runId         String?
  run           Run?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// Set when a pending row must resume as this trigger so its reply can be delivered.
  originTrigger String?
  /// Model agreed for an inbound delivery that had to wait. Empty follows the bot.
  modelProvider String?
  modelId       String?
  thinkingLevel String?
  claimedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@unique([messageId, botId])
  @@index([botId, runId, createdAt])
  @@index([runId])
  @@map("steering_messages")
}

model Attempt {
  id         String    @id @default(cuid())
