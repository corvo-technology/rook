model AgentSecret {
  id              String   @id @default(cuid())
  spaceId         String
  space           Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  name            String
  secretId        String   @unique
  secret          Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([spaceId, name])
  @@index([spaceId, updatedAt])
  @@map("agent_secrets")
}

// Deployment-owned integration credentials; never exposed through read DTOs.
model IntegrationProviderConfig {
  id         String   @id
  ciphertext String
  updatedAt  DateTime @updatedAt

  @@map("integration_provider_configs")
}

model Board {
  id           String   @id @default(cuid())
  spaceId      String   @unique
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name         String   @default("Board")
  ticketPrefix String   @default("RAK")
  nextNumber   Int      @default(1)
  /// Only the column names a person changed; the rest keep their built-in names.
  statusLabels Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tickets      Ticket[]

  @@map("boards")
}

model Ticket {
  id              String          @id @default(cuid())
  boardId         String
  board           Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  spaceId         String
  space           Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  number          Int
  title           String
  description     String?
  status          String          @default("todo")
  priority        String?
  assigneeBotId   String?
  assigneeBot     Bot?            @relation("TicketAssigneeBot", fields: [assigneeBotId], references: [id], onDelete: SetNull)
  createdByBotId  String?
  createdByBot    Bot?            @relation("TicketCreatorBot", fields: [createdByBotId], references: [id], onDelete: SetNull)
  createdByUserId String?
  createdByUser   User?           @relation("TicketCreatorUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  completedAt     DateTime?
  /// Named data the people and agents keep on the ticket: a list of { name, value }.
  fields          Json?
  comments        TicketComment[]

  @@unique([boardId, number])
  @@index([spaceId, status])
  @@index([boardId, status])
  @@map("tickets")
}

model TicketComment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  spaceId      String
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorBotId  String?
  authorBot    Bot?     @relation("TicketCommentAuthorBot", fields: [authorBotId], references: [id], onDelete: SetNull)
  authorUserId String?
  authorUser   User?    @relation("TicketCommentAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

/// Wallet projection; financial deltas live in the append-only billing journal.
model ModelCreditAccount {
  organizationId        String             @id
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mode                  String?
  balanceMicros         BigInt             @default(0)
  pendingCreditCheckout Boolean            @default(false)
  byokFreeUntil         DateTime?
  entries               ModelCreditEntry[]
  lots                  ModelCreditLot[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@map("model_credit_accounts")
}

/// Current purchase, reservation, or expiry projection. Database triggers journal every change.
model ModelCreditEntry {
  id                     String             @id @default(cuid())
  organizationId         String
  account                ModelCreditAccount @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)
  source                 String             @unique
  amountMicros           BigInt
  pending                Boolean            @default(false)
  callId                 String?            @unique
  userId                 String?
  spaceId                String?
  runId                  String?
  provider               String?
  model                  String?
  providerRequestId      String?
  usage                  Json?
  reconciliationState    String?
  reconciliationAttempts Int                @default(0)
  nextReconcileAt        DateTime?
  auditRevision          Int                @default(0)
  allocations            Json?
  /// Sum of allocations; detects settlements by older writers without inferring credit provenance.
  fundedMicros           BigInt?
  createdAt              DateTime           @default(now())

  @@index([reconciliationState, nextReconcileAt])
  @@index([organizationId, createdAt])
  @@map("model_credit_entries")
}

/// Immutable financial journal. Deliberately no lifecycle foreign keys.
model BillingAuditEvent {
  id                String   @id @default(cuid())
  source            String   @unique
  kind              String
  organizationId    String?
  callId            String?
  userId            String?
  spaceId           String?
  provider          String?
  model             String?
  providerRequestId String?
  amountMicros      BigInt   @default(0)
  currency          String   @default("usd")
  details           Json
  createdAt         DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([callId, createdAt])
  @@map("billing_audit_events")
}

/// Grant allocation projection. Used funds include reservations; null expiry means non-expiring.
model ModelCreditLot {
  id              String             @id
  organizationId  String
  account         ModelCreditAccount @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)
  amountMicros    BigInt
  availableMicros BigInt
  usedMicros      BigInt             @default(0)
  expiredMicros   BigInt             @default(0)
  expiresAt       DateTime?
  auditRevision   Int                @default(0)
  createdAt       DateTime           @default(now())

  @@index([organizationId, expiresAt])
  // Partial indexes for outstanding grants are managed in SQL migrations.
  @@map("model_credit_lots")
}

model SpaceModelRoleChoice {
  spaceId       String
  userId        String
  spaceMember   SpaceMember          @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  role          String
  position      Int
  provider      String
  modelId       String
  thinkingLevel String?
  credentialId  String?
  credential    UserModelCredential? @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)

  @@id([spaceId, userId, role, position])
  @@index([credentialId, userId])
  @@map("space_model_role_choices")
}

/// Which of a member's account-wide settings a Space replaces with its own. Without a row the
/// Space follows the account: "models" covers every model role, "voice" the voice choices,
/// "confirmations" the approval rules and auto review.
model SpaceSettingOverride {
  spaceId     String
  userId      String
  spaceMember SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  setting     String
  createdAt   DateTime    @default(now())

  @@id([spaceId, userId, setting])
  @@map("space_setting_overrides")
}

/// The member's account-wide models per purpose; position 0 runs, the rest take over in order.
model UserModelRoleChoice {
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String
  position      Int
  provider      String
  modelId       String
  thinkingLevel String?
  credentialId  String?
  credential    UserModelCredential? @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)

  @@id([userId, role, position])
  @@index([credentialId, userId])
  // Unique index user_model_role_choices_model_connection_key (NULLS NOT DISTINCT) is created in SQL.
  @@map("user_model_role_choices")
}

/// A connection's own model and effort, which belong to the connection in every Space.
model UserModelPreference {
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId  String
  credential    UserModelCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)
  modelId       String?
  thinkingLevel String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@id([userId, credentialId])
  @@map("user_model_preferences")
}

/// The member's account-wide voice per voice connection; one is the default.
model UserVoicePreference {
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String
  credential   UserVoiceCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)
  voiceId      String              @default("")
  // Fish speech-model override. Null keeps the deployment default.
  speechModel  String?
  isDefault    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@id([userId, credentialId])
  // Partial unique index user_voice_preferences_default_key is created in SQL.
  @@map("user_voice_preferences")
}

/// The member's account-wide action approval rules.
model UserActionApprovalRule {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  effect     String
  matchKind  String
  matchValue String
  createdAt  DateTime @default(now())

  @@unique([userId, effect, matchKind, matchValue])
  @@map("user_action_approval_rules")
}

/// The member's account-wide auto review and skip-approvals choice.
model UserActionAutoReviewPreference {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled       Boolean  @default(false)
  skipApprovals Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("user_action_auto_review_preferences")
}

model MessagingInstallation {
  id                String              @id @default(cuid())
  provider          String
  workspaceId       String
  workspaceName     String
  spaceId           String
  space             Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId             String
  bot               Bot                 @relation(fields: [botId], references: [id], onDelete: Cascade)
  ciphertext        String
  /// Connector ids a visitor's run may use on a linked WhatsApp number; everything else is off.
  visitorConnectors String[]            @default([])
  /// "assistant" answers only the owner's own chat; "service" also answers anyone who writes.
  /// Existing numbers answered everyone, so that is the column default; new links choose.
  mode              String              @default("service")
  /// "active" or "disconnected" (WhatsApp logged the linked device out).
  status            String              @default("active")
  pausedAt          DateTime?
  resumedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  identities        MessagingIdentity[]
  whatsappAuth      WhatsAppAuthEntry[]

  @@unique([provider, workspaceId])
  @@index([spaceId, userId])
  @@map("messaging_installations")
}

/// One encrypted piece of a linked WhatsApp number's session (credentials and signal keys).
model WhatsAppAuthEntry {
  installationId String
  installation   MessagingInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  name           String
  ciphertext     String
  updatedAt      DateTime              @updatedAt

  @@id([installationId, name])
  @@map("whatsapp_auth_entries")
}

model MessagingInstallSession {
  id        String   @id
  provider  String
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("messaging_install_sessions")
}

/// A SaaS that sends its customers to Corvo. Platform-level: only server code reads it.
model Partner {
  id                  String                 @id @default(cuid())
  slug                String                 @unique
  name                String
  /// Looks the row up without revealing the key; the key itself is never stored.
  keyPrefix           String                 @unique
  keyHash             String
  enabled             Boolean                @default(true)
  createdAt           DateTime               @default(now())
  /// The person who manages this partner in the app; null for one made on the command line.
  ownerUserId         String?                @unique
  owner               User?                  @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  /// What every new customer gets: { connector?: {slug,name,endpoint}, agents: [...] }.
  template            Json?
  /// The most this partner passes on to one customer, and to all customers together, per month.
  perTenantLimitCents Int?
  monthlyLimitCents   Int?
  tenants             PartnerTenant[]
  codes               PartnerEntryCode[]
  windows             PartnerRequestWindow[]

  @@map("partners")
}

/// One partner customer: its own organization and the single Corvo user that owns its agents.
model PartnerTenant {
  id               String             @id @default(cuid())
  partnerId        String
  partner          Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  externalTenantId String
  organizationId   String             @unique
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUserId      String
  owner            User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  /// enabled | suspended. The partner decides; Corvo enforces.
  state            String             @default("enabled")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  codes            PartnerEntryCode[]

  @@unique([partnerId, externalTenantId])
  @@map("partner_tenants")
}

/// A one-time code that turns a partner's request into a session. Only its hash is stored.
/// Requests a partner made in one minute, shared by every API process.
model PartnerRequestWindow {
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  windowStart DateTime
  count       Int      @default(0)

  @@id([partnerId, windowStart])
  @@map("partner_request_windows")
}

model PartnerEntryCode {
  id             String        @id @default(cuid())
  codeHash       String        @unique
  partnerId      String
  partner        Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         PartnerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Which of the partner's people asked, kept for audit.
  externalUserId String
  externalEmail  String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([expiresAt])
  @@map("partner_entry_codes")
}

/// The owner lends the models they connected to everyone in a Space: members' runs resolve
/// models as `ownerUserId` does and never see a key. No row means each member uses their own.
model SpaceModelConnection {
  spaceId     String      @id
  ownerUserId String
  spaceMember SpaceMember @relation(fields: [spaceId, ownerUserId], references: [spaceId, userId], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@map("space_model_connections")
}

/// What the owner sets for one member on the lent models, and the member's own choice to leave them.
model SpaceMemberModelSetting {
  spaceId           String
  userId            String
  spaceMember       SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  /// The member runs on their own connections instead of the lent ones.
  useOwnModel       Boolean     @default(false)
  /// Tokens the member may spend a UTC month on the lent models; null is no limit.
  monthlyTokenLimit BigInt?
  updatedAt         DateTime    @updatedAt

  @@id([spaceId, userId])
  @@map("space_member_model_settings")
}
