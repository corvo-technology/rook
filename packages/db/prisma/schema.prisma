/// A short fact or preference about one person in one space, read by all of that person's agents.
model UserMemory {
  id          String   @id @default(cuid())
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// One line, encrypted at rest.
  text        String
  /// "pending" waits for Save, "saved" is read by agents, "forgotten" is kept only so it is not learned again.
  state       String   @default("saved")
  /// "typed", "agent" or "learned".
  source      String
  botId       String?
  threadId    String?
  /// One-way digest of the normalized text, so a forgotten fact is not proposed again.
  fingerprint String
  /// When the person last saw it and let it stand.
  confirmedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([spaceId, userId, fingerprint])
  @@index([spaceId, userId, state])
  @@map("user_memories")
}

model MemoryRevision {
  id             String         @id @default(cuid())
  documentId     String
  document       MemoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision       Int
  content        String
  sourceRunId    String?
  sourceThreadId String?
  createdAt      DateTime       @default(now())

  @@unique([documentId, revision])
  @@map("memory_revisions")
}

