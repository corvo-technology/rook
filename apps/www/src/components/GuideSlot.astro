---
import { MASCOT_COLOR } from "../mascot";
import Avatar from "./Avatar.astro";

type Props = {
  /** Reserved empty space above a section's title: the rook may travel the margin between rows. */
  row?: boolean;
  mood?: "idle" | "happy";
  class?: string;
  /** Use "li" inside a list. */
  as?: "span" | "li";
};

const { row = false, mood = "idle", class: className, as: Tag = "span" } = Astro.props;
---

<!-- A place the guide rook rests, always empty space. Without the script, or with reduced motion, a still rook sits here. -->
<Tag class:list={["guide-slot", className]} data-guide-stop data-guide-row={row ? "" : undefined} aria-hidden="true">
  <Avatar color={MASCOT_COLOR.menta} mood={mood} />
</Tag>
