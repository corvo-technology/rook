---
import { CHESS_PIECES, ROOK_AVATAR, ROOK_EYE_COLOR } from "@corvo/core";
import { renderAvatarSvg } from "open-bot-avatar";

type Props = { label: string; captions: Record<"sales" | "marketing" | "development" | "finance" | "support" | "operations", string> };
const { label, captions } = Astro.props;

/** Six agents, each piece in its own color, with the job it does. */
const AGENTS = [
  { piece: "rook", definition: ROOK_AVATAR, color: "#e5833a", caption: captions.sales },
  { piece: "queen", definition: CHESS_PIECES.queen, color: "#d9a23a", caption: captions.marketing },
  { piece: "knight", definition: CHESS_PIECES.knight, color: "#3fbf74", caption: captions.development },
  { piece: "bishop", definition: CHESS_PIECES.bishop, color: "#2fc0a6", caption: captions.finance },
  { piece: "king", definition: CHESS_PIECES.king, color: "#3b8ff0", caption: captions.support },
  { piece: "pawn", definition: CHESS_PIECES.pawn, color: "#9b55e8", caption: captions.operations },
] as const;

const agents = AGENTS.map((agent) => ({
  ...agent,
  svg: renderAvatarSvg(agent.definition, { color: agent.color, eyeColor: ROOK_EYE_COLOR, state: "idle", mood: "happy", reducedMotion: true })
    .replace(/ role="img" aria-label="[^"]*"/, ' aria-hidden="true"')
    .replace(/<title>[^<]*<\/title>/, ""),
}));
---

<!-- Still pictures from the server. The script wakes one agent at a time while the row is on screen. -->
<ul class="agent-row" aria-label={label} data-agent-row>
  {
    agents.map((agent) => (
      <li class="agent-row__item">
        <span class="agent-row__avatar" data-piece={agent.piece} data-color={agent.color} set:html={agent.svg} />
        <span class="agent-row__caption">{agent.caption}</span>
      </li>
    ))
  }
</ul>

<script>
  import "../agent-grid";
</script>
