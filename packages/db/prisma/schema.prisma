}

model ComputerUpdate {
  action     String   @default("update")
  id         String   @id @default(cuid())
  computerId String
  computer   Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
  botId      String
  status     String   @default("queued")
  stage      String   @default("preparing")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([computerId, createdAt])
  @@index([status, updatedAt])
  @@map("computer_updates")
}

model Computer {
  screenGeneration        Int                      @default(0)
  id                      String                   @id @default(cuid())
  spaceId                 String
  space                   Space                    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId                  String
  scope                   String                   @default("team")
  scopeKey                String                   @unique
  homeKey                 String                   @unique
  homeRevision            String                   @default("empty")
  /// When the sandbox was read for `homeRevision`; null when an older release saved it.
  homeRevisionAt          DateTime?
  /// When a damaged system last made Corvo stop and start the computer by itself. Tried once
  /// until a later save shows the computer works again.
  autoRecoveredAt         DateTime?
  /// Object storage only: random id naming the home's objects, its data key (wrapped by the
  /// space key) and the revision stored there. Deleting the computer deletes the key.
  homeStorageId           String?                  @unique
  homeStorageKey          String?
  homeStorageRevision     String?
  kind                    String
  providerRef             String?
  state                   String                   @default("stopped")
  controlHolder           String                   @default("none")
  controlLeaseId          String?
  controlLeaseExpiresAt   DateTime?
  controlBotId            String?
  controlRunId            String?
  controlFence            Int                      @default(0)
  executionRunId          String?
  executionBotId          String?
  executionLeaseExpiresAt DateTime?
  executionFence          Int                      @default(0)
  screenUrl               String?
  /// When the computer last started running; bounds how long it can stay up in one stretch.
  runningSince            DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  bots                    Bot[]
  executionLeases         ComputerExecutionLease[]
  maintenanceId           String?
  updates                 ComputerUpdate[]

  @@index([spaceId, scope])
  @@map("computers")
}

/// One stretch a computer ran at its provider, from `computers.runningSince` until it stopped,
/// attributed to the computer's owning user and space. Run time is what sandbox providers bill.
///
/// `computerId` is deliberately not a relation, so the row outlives a deleted computer. Deleting
/// the user or space anonymises the row instead of erasing the run time it records.
model ComputerRun {
  id          String    @id @default(cuid())
  computerId  String
  spaceId     String?
  space       Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// The provider kind, such as docker or e2b.
  kind        String
  /// The provider's id for the sandbox, to match runs with the provider's own usage and billing.
  providerRef String?
  startedAt   DateTime
  /// Null while running. When the end was not seen as it happened, this is when it was detected.
  endedAt     DateTime?
  /// How it ended; see `ComputerRunEnd` in packages/db/src/computer-runs.ts.
  endReason   String?

  @@unique([computerId, startedAt])
  @@index([spaceId, userId, startedAt])
  // computer_runs_open_idx (open runs by computer) is raw SQL: Prisma cannot express partial indexes.
  @@map("computer_runs")
}

model ComputerExecutionLease {
  id         String   @id @default(cuid())
  computerId String
  computer   Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
  botId      String
  runId      String
  fence      Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([computerId, botId])
  @@index([runId])
  @@index([computerId, expiresAt])
  @@index([botId, expiresAt])
  @@map("computer_execution_leases")
}

model Artifact {
  id          String     @id @default(cuid())
  spaceId     String
  space       Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId       String?
  bot         Bot?       @relation(fields: [botId], references: [id], onDelete: SetNull)
  groupId     String?
  group       ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  runId       String?
  name        String
  description String?
  mimeType    String
  size        Int
  hash        String
  storageKey  String
  createdAt   DateTime   @default(now())

  // Null on the first version; that row's id is the family's stable id.
  rootArtifactId String?
  rootArtifact   Artifact?           @relation("ArtifactVersions", fields: [rootArtifactId], references: [id], onDelete: Cascade)
  versions       Artifact[]          @relation("ArtifactVersions")
  version        Int                 @default(1)
  // Client-chosen per upload so a retried upload that already landed returns this row.
  clientNonce    String?
  transcript     ArtifactTranscript?

  @@unique([spaceId, userId, clientNonce])
  @@index([spaceId, botId])
  @@index([groupId])
  @@index([rootArtifactId])
  // artifacts_family_version_key is raw SQL: Prisma cannot express COALESCE indexes.
  @@map("artifacts")
}

/// What an audio artifact said, kept so a retry or a later run does not transcribe it again.
/// Only successful transcriptions are stored: a failure such as being offline is tried again.
model ArtifactTranscript {
  artifactId String   @id
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  text       String
  /// The language the model heard, as an ISO 639-1 code, when it said.
  language   String?
  createdAt  DateTime @default(now())

  @@index([spaceId])
  @@map("artifact_transcripts")
}

model UsageRecord {
  id                 String   @id @default(cuid())
  spaceId            String
  /// Which bot spent this. Deliberately NOT a relation: a usage row is spend that really
  /// happened, and no lifecycle event on the bot may delete it or blank its attribution.
  /// `Cascade` erased the row; `SetNull` would erase the attribution instead, and because
  /// deleting a bot also deletes its runs, `runId` goes null in the same breath — the row
  /// would keep only space, user, model and token counts.
  ///
  /// So the id outlives the bot and may dangle. Read it with a LEFT JOIN; `BotDeletion.id`
  /// IS the bot id, so a deleted bot's name is still reachable for display.
  botId              String?
  userId             String
  runId              String?
  provider           String
  model              String
  /// Uncached input; cache buckets are additional, reasoning is a subset of output.
  inputTokens        Int?
  outputTokens       Int?
  cacheReadTokens    Int?
  cacheWriteTokens   Int?
  cacheWrite1hTokens Int?
  reasoningTokens    Int?
  totalTokens        Int?
  costUsd            Float?
  providerRequestId  String?
  currency           String   @default("usd")
  auditRevision      Int      @default(0)
  costSource         String?
  pricingVersion     String?
  pricingSnapshot    Json?
  usageSource        String?
  callId             String?  @unique
  operationId        String?
  operationKind      String   @default("answer")
  /// Durable attribution, deliberately without lifecycle foreign keys.
  parentRunId        String?
  agentId            String?
  createdAt          DateTime @default(now())

  @@index([spaceId, userId, createdAt])
  @@index([botId, createdAt], map: "usage_records_bot_created_idx")
  @@map("usage_records")
}

model NotificationPreference {
  id       String  @id @default(cuid())
  spaceId  String
  space    Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId   String
  finish   Boolean @default(true)
  help     Boolean @default(true)
  takeover Boolean @default(true)

  @@unique([spaceId, userId])
  @@map("notification_preferences")
}

model SpaceMemoryConfig {
  id                 String   @id @default(cuid())
  spaceId            String   @unique
  space              Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId             String
  provider           String
  settings           Json
  secretId           String   @unique
  secret             Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)
  defaultMemoryScope String   @default("isolated")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("space_memory_configs")
}

model Secret {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId           String?
  space             Space?             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  kind              String
  ciphertext        String
  createdAt         DateTime           @default(now())
  mcpServers        McpServer[]
  spaceMemoryConfig SpaceMemoryConfig?
  agentSecret       AgentSecret?

  @@index([userId, spaceId])
  @@map("secrets")
}

model McpServer {
  id              String            @id @default(cuid())
  spaceId         String
  space           Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  description     String            @default("")
  transport       String
  endpoint        String?
  command         String?
  args            Json              @default("[]")
  env             Json              @default("{}")
  files           Json              @default("{}")
  headers         Json              @default("{}")
  secretId        String?
  secret          Secret?           @relation(fields: [secretId], references: [id], onDelete: SetNull)
  enabled         Boolean           @default(true)
  revision        Int               @default(1)
  /// Last launch/discovery outcome: unknown | installing | ok | error.
  healthStatus    String            @default("unknown")
  healthMessage   String?
  healthToolCount Int?
  healthCheckedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  assignments     BotMcpServer[]
  oauthSessions   McpOAuthSession[]

  @@unique([spaceId, userId, slug])
  @@index([spaceId, userId])
  @@map("mcp_servers")
}

model McpOAuthSession {
  id              String    @id
  spaceId         String
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId          String
  serverId        String
  server          McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  endpoint        String
  redirectUri     String
  oauthCiphertext String
  createdAt       DateTime  @default(now())

  @@index([spaceId, userId, createdAt])
  @@map("mcp_oauth_sessions")
}

/// A subscription sign-in waiting for its pasted code, so whichever API process
/// receives the code can finish it. The ciphertext holds the PKCE verifier.
model ModelOAuthSession {
  id         String   @id
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  provider   String
  /// The connection it signs in to; a newer sign-in for the same one replaces it.
  scope      String
  ciphertext String
  createdAt  DateTime @default(now())

  @@index([userId, provider])
  @@index([scope])
  @@index([createdAt])
  @@map("model_oauth_sessions")
}

/// What a subscription provider last said about the person's windows (5 hours, week). One row per
/// person and provider, replaced by each reading; a provider that reports nothing has no row.
/// The wiki's own settings for a Space: whether the curator reads conversations, and whether edits
/// to existing pages wait for approval ("approve") or go in at once ("auto").
model WikiSettings {
  spaceId    String    @id
  space      Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  capture    Boolean   @default(true)
  edits      String    @default("approve")
  /// When the weekly review last started for this Space; null until the first one.
  reviewedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@map("wiki_settings")
}

/// What a wiki change came from, kept as it was said. Text and title are encrypted at rest.
model WikiSource {
  id        String      @id @default(cuid())
  spaceId   String
  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// The conversation's owner: the only person shown the quoted text.
  userId    String
  threadId  String?
  thread    Thread?     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// "conversation" (read by the curator), "message" (kept on purpose), "note" (saved by an agent),
  /// "file" (a document read part by part) or "review" (found by the weekly review of the pages themselves).
  origin    String
  title     String
  text      String
  fromSeq   Int?
  toSeq     Int?
  messageId String?
  createdAt DateTime    @default(now())
  change    WikiChange?

  @@unique([threadId, fromSeq, toSeq])
  @@unique([threadId, messageId])
  @@index([spaceId])
  @@map("wiki_sources")
}

/// A package of page operations: "pending" until approved, then "applied" (or "refused", "conflict"
/// when a page moved on, "undone"). Operations and reason are encrypted at rest.
model WikiChange {
  id               String     @id @default(cuid())
  spaceId          String
  space            Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId           String
  sourceId         String     @unique
  source           WikiSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  state            String     @default("pending")
  ops              Json
  reason           String
  /// { "<page title>": revision the operations were written against (0 for a new page) }
  baseRevisions    Json
  /// { "<page title>": revision this change produced }, filled as pages are written.
  appliedRevisions Json?
  anchorThreadId   String?
  anchorMessageId  String?
  decidedByUserId  String?
  /// Set while someone is writing this change's pages, so two answers cannot write them twice.
  claimedAt        DateTime?
  createdAt        DateTime   @default(now())
  decidedAt        DateTime?

  @@index([spaceId, state])
  @@map("wiki_changes")
}

/// A file being read into the wiki: "reading" while the curator works through it, then "done" or "failed".
model WikiImport {
  id         String   @id @default(cuid())
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  state      String   @default("reading")
  /// How many parts the file was cut into, and how many the curator has read so far.
  parts      Int      @default(0)
  readParts  Int      @default(0)
  /// What went wrong, in words a person can act on, when the state is "failed".
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([spaceId, state])
  @@map("wiki_imports")
}

model ProviderQuota {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  provider  String
  /// [{ "key": "5h" | "7d", "usedPercent": 0-100, "resetsAt": ISO time }]
  windows   Json
  updatedAt DateTime @updatedAt

  @@unique([spaceId, userId, provider])
  @@map("provider_quotas")
}

/// How far a member of a space has come with the first missions. A row exists only for an account
/// that started with the short navigation; without one the full navigation shows.
model MissionState {
  id         String    @id @default(cuid())
  spaceId    String
  space      Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  /// Mission ids already completed; a mission never leaves the list.
  completed  String[]  @default([])
  /// Navigation parts a mission brought that the member has opened.
  seenParts  String[]  @default([])
  /// When the member chose to show everything; null while the navigation is still growing.
  shownAllAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([spaceId, userId])
  @@map("mission_states")
}

model BotMcpServer {
  id            String    @id @default(cuid())
  spaceId       String
  space         Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId         String
  bot           Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  serverId      String
  server        McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId        String
  allowAllTools Boolean   @default(true)
  allowedTools  Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([botId, serverId])
  @@index([spaceId, userId, botId])
  @@map("bot_mcp_servers")
}

model MessagingIdentity {
  id                   String                 @id @default(cuid())
  provider             String
  /// Sender address within the provider: E.164 number, Slack user id, ….
  address              String
  /// Opaque provider thread id for the 1:1 conversation; learned on inbound.
  dmThreadId           String?
  installationId       String?
  installation         MessagingInstallation? @relation(fields: [installationId], references: [id], onDelete: Cascade)
  userId               String
  spaceId              String
  space                Space                  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                String                 @unique
  verifiedAt           DateTime?
  lastInboundAt        DateTime?
  outboundSinceInbound Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([provider, address])
  @@index([userId])
  @@index([installationId])
  @@map("messaging_identities")
}

model MessagingChannel {
  id            String                   @id @default(cuid())
  provider      String
  /// Opaque provider thread id of the group conversation.
  threadId      String                   @unique
  name          String?
  introPostedAt DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  members       MessagingChannelMember[]

  @@map("messaging_channels")
}

model MessagingChannelMember {
  id         String           @id @default(cuid())
  channelId  String
  channel    MessagingChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  address    String
  identityId String?
  status     String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([channelId, address])
  @@index([identityId])
  @@map("messaging_channel_members")
}

/// Short-lived web-issued code binding a chat address to an existing user+bot.
model MessagingLinkCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  spaceId   String
  botId     String
