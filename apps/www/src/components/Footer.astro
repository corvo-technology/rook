---
import {
  DEFAULT_LOCALE,
  LOCALE_HREFLANG,
  LOCALE_LABELS,
  LOCALES,
  isLocale,
  localeHashPath,
  localeHomePath,
  type Locale,
} from "../i18n/locales";
import { getLaunchCopy } from "../i18n/launch";
import { partnersPath } from "../i18n/partners";
import { DOCS_URL } from "../site";
import Logo from "./Logo.astro";

type Props = {
  locale?: Locale;
  homeHref?: string;
};

const currentLocale: Locale =
  Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE);
const { footer: copy, nav } = getLaunchCopy(currentLocale);
const homeHref = Astro.props.homeHref ?? localeHomePath(currentLocale);

// The company's accounts. Placeholders until the real profiles exist.
const SOCIAL = [
  { label: "X", href: "#" },
  { label: "LinkedIn", href: "#" },
  { label: "Instagram", href: "#" },
];

// Only pages that exist: the rest of the site is one page with sections.
const links = [
  { label: copy.resources, href: localeHashPath(currentLocale, "features") },
  { label: copy.download, href: localeHashPath(currentLocale, "install") },
  { label: copy.partners, href: partnersPath(currentLocale) },
  { label: copy.docs, href: DOCS_URL },
  { label: copy.useCases, href: localeHashPath(currentLocale, "store") },
  { label: copy.about, href: "/about/" },
  { label: copy.support, href: "/support/" },
];
const legal = [
  { label: copy.terms, href: "/terms/" },
  { label: copy.privacy, href: "/privacy/" },
];
---

<footer class="site-footer">
  <div class="site-footer__top">
    <div class="site-footer__brand">
      <Logo href={homeHref} label={nav.home} />
      <ul class="site-footer__social">
        {SOCIAL.map((item) => <li><a href={item.href} rel="noopener">{item.label}</a></li>)}
      </ul>
    </div>
    <div class="site-footer__tools">
      <label class="site-footer__language">
        <span>{copy.languagesLabel}</span>
        <select data-language>
          {
            LOCALES.map((locale) => (
              <option value={localeHomePath(locale)} lang={LOCALE_HREFLANG[locale]} selected={locale === currentLocale}>
                {LOCALE_LABELS[locale]}
              </option>
            ))
          }
        </select>
      </label>
      <button type="button" class="site-footer__theme" data-theme-toggle data-dark={copy.themeDark} data-light={copy.themeLight} aria-label={copy.themeDark}>
        <svg class="site-footer__moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /></svg>
        <svg class="site-footer__sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
    </div>
  </div>
  <nav class="site-footer__links" aria-label={copy.navLabel}>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <nav class="site-footer__links" aria-label={copy.legalLabel}>
    {legal.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <div class="site-footer__fine">
    <span>{copy.tagline}</span>
    <span>{copy.producedBy} Greenflow · CNPJ 61.469.487/0001-40 · Ourinhos, SP</span>
  </div>
</footer>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const label = () => {
    const dark = root.dataset.theme === "dark";
    // The button names what it switches to.
    toggle?.setAttribute("aria-label", (dark ? toggle.dataset.light : toggle.dataset.dark) ?? "");
  };
  label();
  toggle?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      // The choice just does not persist.
    }
    label();
  });
  document.querySelector<HTMLSelectElement>("[data-language]")?.addEventListener("change", (event) => {
    location.href = (event.target as HTMLSelectElement).value;
  });
</script>
