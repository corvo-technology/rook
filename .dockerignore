.git
.github
.vercel
.turbo
.cache
.DS_Store
.env
.env.*
node_modules
**/node_modules
**/dist
**/build
**/out
**/.expo
**/.astro
coverage
data
artifacts
backups
design
PRODUCT_PLAN.md
playwright-report
test-results
verify-report
*.log

# Credentials, dumps and agent scratch never belong in an image. CI builds from a clean checkout;
# these keep an untracked file out of a fallback build on a host checkout. infra/compose/
# check-image.sh fails the publish if one still gets in.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ecdsa*
**/id_ed25519*
**/*.csv
**/*.dump
**/*.sqlite
.context
.claude
.deepsec
.tmp
.playwright-cli
.deploy.lock
.last-deployed-revision

# Never read by an image build. Keeping them out shrinks the context sent to the builder and keeps
# an edit to a test, a document or an app an image does not ship from invalidating a `COPY` and
# the install or build after it. Every Dockerfile that copies a whole package or app still gets
# the sources it builds from; the manifests of apps/desktop, apps/mobile and packages/testkit
# stay because infra/compose/Dockerfile copies them for the lockfile check.
graphify-out
docs
.agents
.github
.vscode
.idea
.vite
.astro
/*.md
**/*.tsbuildinfo
**/*.test.ts
**/*.test.tsx
**/*.test.mjs
**/*.spec.ts
**/e2e
**/playwright*.config.ts
**/screenshots
apps/desktop/**
!apps/desktop/package.json
apps/mobile/**
!apps/mobile/package.json
packages/testkit/**
!packages/testkit/package.json
