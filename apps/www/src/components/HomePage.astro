---
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { Rook } from "./Rook";
import { ProductPreview } from "./ProductPreview";
import { AGENT_CATALOG } from "@corvo/core";
import type { StoreCategory } from "../i18n/launch";
import type { Locale } from "../i18n/locales";
import { getLaunchCopy } from "../i18n/launch";
import { DEFAULT_LOCALE, LOCALE_HTML_LANG, isLocale, localeHomePath } from "../i18n/locales";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  DOWNLOAD_URL,
  DOWNLOAD_URL_LINUX,
  DOWNLOAD_URL_WINDOWS,
  GITHUB_URL,
  INSTALL_COMMAND,
  INSTALL_COMMAND_WINDOWS,
  SITE_URL,
} from "../site";
import { homeStructuredData } from "../structured-data";
import "../styles/launch.css";

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;

const copy = getLaunchCopy(locale);
const homeHref = localeHomePath(locale);
const pageUrl = `${SITE_URL}${homeHref === "/" ? "/" : homeHref}`;

const structuredData = homeStructuredData({
  pageUrl,
  title: copy.meta.title,
  description: copy.meta.description,
  inLanguage: LOCALE_HTML_LANG[locale],
  faq: copy.faq.items,
});

// Social images exist for these languages; the others borrow the English one until theirs is drawn.
const OG_LOCALES: readonly Locale[] = ["pt", "es", "fr", "de", "ja", "zh"];
const ogImage = OG_LOCALES.includes(locale) ? `/og-image-${locale}.png` : "/og-image.png";

const { works } = copy;

// The Store's agents come from the product's own catalog, so the page says what is there.
const catalogLocale = locale === "pt" ? "pt-BR" : "en";
const CATEGORY_ORDER: StoreCategory[] = ["finance", "operations", "marketing", "support"];
const storeGroups = CATEGORY_ORDER.map((category) => ({
  category,
  names: AGENT_CATALOG.filter((entry) => entry.category === category)
    .slice(0, 3)
    .map((entry) => entry.name[catalogLocale] ?? entry.name.en),
}));
const CATALOG_URL = `${GITHUB_URL}/blob/HEAD/packages/core/src/agent-catalog-data.ts`;
// Brand names, the same in every language.
const MODEL_CHIPS = ["Claude", "ChatGPT", "OpenRouter"];
// The four states an agent is in, the same ones the app shows on its rooks.
const STATES = [
  { mood: "working", hue: "azul" },
  { mood: "asking", hue: "laranja" },
  { mood: "sleeping", hue: "neutro" },
  { mood: "done", hue: "menta" },
] as const;
const [featureCards, plainItems] = [works.cards.slice(0, 3), works.cards.slice(3)];
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  {structuredData}
  locale={locale}
  skipLabel={copy.meta.skipToContent}
  homeAlternates
  ogImageAlt={copy.meta.ogImageAlt}
  ogImage={ogImage}
>
  <div class="container">
    <Header locale={locale} copy={copy.nav} homeHref={homeHref} />

    <main id="main">
      <section class="lp-hero">
        <h1>
          <span>{copy.hero.line1}</span>
          <Rook hue="menta" size={108} float react label="Rook" />
          <span>{copy.hero.line2}</span>
        </h1>
        <p class="lp-hero__lead">{copy.hero.lead[0]}<br />{copy.hero.lead[1]}</p>
        <div class="lp-hero__actions">
          <a class="button button--primary" href={DOWNLOAD_URL} target="_blank" rel="noopener" data-attr="hero-download">
            {copy.cta.download}
          </a>
          <p class="download-note">
            {
              copy.hero.note.split(/(\{windows\}|\{linux\})/).map((part) =>
                part === "{windows}" ? (
                  <a href={DOWNLOAD_URL_WINDOWS} data-attr="hero-download-windows">Windows</a>
                ) : part === "{linux}" ? (
                  <a href={DOWNLOAD_URL_LINUX} data-attr="hero-download-linux">Linux</a>
                ) : (
                  part
                ),
              )
            }
          </p>
        </div>
        <div class="lp-hero__demo">
          <ProductPreview copy={copy.preview} client:visible />
        </div>
      </section>

      <section id="agents" class="lp-agent" aria-labelledby="agent-heading">
        <div class="lp-center" data-reveal>
          <h2 id="agent-heading" class="lp-title">{copy.agent.accent}</h2>
          <p class="lp-lead">{copy.agent.copy}</p>
        </div>
        <ul class="lp-states" data-reveal>
          {
            STATES.map((state, index) => (
              <li>
                <button type="button" class="state">
                  <Rook hue={state.hue} size={56} mood={state.mood} seed={index + 6} gaze={false} ring={state.mood === "working"} still />
                  <span>{copy.agent.states[state.mood]}</span>
                </button>
              </li>
            ))
          }
        </ul>
        <ul class="lp-traits" data-reveal>
          {
            copy.agent.traits.map((trait) => (
              <li>
                <h3>{trait.title}</h3>
                <p>{trait.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="store" class="lp-store" aria-labelledby="store-heading">
        <div class="lp-store__intro" data-reveal>
          <h2 id="store-heading" class="lp-title">{copy.store.accent}</h2>
          <p class="lp-lead">{copy.store.copy}</p>
        </div>
        <div class="lp-rows" data-reveal>
          {
            storeGroups.map((group) => (
              <div class="lp-store__row">
                <h3>{copy.store.categories[group.category]}</h3>
                <ul>
                  {group.names.map((name) => (
                    <li>{name}</li>
                  ))}
                </ul>
              </div>
            ))
          }
          <p class="lp-store__all">
            <a href={CATALOG_URL} target="_blank" rel="noopener" data-attr="store-catalog">{copy.store.all}</a>
          </p>
        </div>
      </section>

      <section id="features" class="lp-works" aria-labelledby="works-heading">
        <h2 id="works-heading" class="lp-title lp-title--center" data-reveal>
          {works.heading}
          <br />
          {works.accent}
        </h2>
        <div class="lp-cards" data-reveal>
          <article class="lp-card">
            <h3>{featureCards[0]!.title}</h3>
            <p>{featureCards[0]!.body}</p>
            <ul class="lp-routines">
              {
                works.routines.slice(0, 3).map((routine) => (
                  <li>
                    <time>{routine.when}</time>
                    <span>{routine.what}</span>
                  </li>
                ))
              }
            </ul>
          </article>
          <article class="lp-card">
            <h3>{featureCards[1]!.title}</h3>
            <p>{featureCards[1]!.body}</p>
            <div class="lp-term" role="img" aria-label={works.computer.title}>
              {works.computer.lines.map((line) => <code data-ok={line.startsWith("✓") ? "" : undefined}>{line}</code>)}
            </div>
          </article>
          <article class="lp-card">
            <h3>{featureCards[2]!.title}</h3>
            <p>{featureCards[2]!.body}</p>
            <ul class="lp-chips">
              {MODEL_CHIPS.map((name) => <li>{name}</li>)}
              <li>{works.models.local}</li>
            </ul>
          </article>
        </div>
        <ul class="lp-items" data-reveal>
          {
            plainItems.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="open" class="lp-open" aria-labelledby="open-heading">
        <div class="lp-open__intro" data-reveal>
          <h2 id="open-heading" class="lp-title">{copy.open.heading} {copy.open.accent}</h2>
          <p class="lp-lead">{copy.open.copy}</p>
          <div class="lp-open__actions">
            <a class="button button--secondary" href={GITHUB_URL} target="_blank" rel="noopener" data-attr="open-github">
              {copy.open.github}
            </a>
            <span class="lp-license">{copy.open.license}</span>
          </div>
        </div>
        <ul class="lp-rows lp-points" data-reveal>
          {
            copy.open.points.map((point) => (
              <li>
                <h3>{point.title}</h3>
                <p>{point.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="install" class="lp-install" aria-labelledby="install-heading">
        <div class="lp-center" data-reveal>
          <h2 id="install-heading" class="lp-title">{copy.install.heading}</h2>
          <p class="lp-lead">{copy.install.copy}</p>
          <a
            class="button button--primary"
            href={DOWNLOAD_URL}
            target="_blank"
            rel="noopener"
            data-attr="install-download"
          >
            {copy.install.download}
          </a>
        </div>
        <div class="lp-commands" data-reveal>
          <div class="lp-command">
            <span>{copy.install.macLinux}</span>
            <code id="install-unix">{INSTALL_COMMAND}</code>
            <button type="button" data-copy="#install-unix" data-copied={copy.install.copiedLabel}>
              {copy.install.copyLabel}
            </button>
          </div>
          <div class="lp-command">
            <span>{copy.install.windows}</span>
            <code id="install-windows">{INSTALL_COMMAND_WINDOWS}</code>
            <button type="button" data-copy="#install-windows" data-copied={copy.install.copiedLabel}>
              {copy.install.copyLabel}
            </button>
          </div>
          <p class="download-note">{copy.install.note}</p>
        </div>
      </section>

      <section id="faq" class="lp-faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="lp-title" data-reveal>{copy.faq.heading}</h2>
        <div class="home-faq" data-reveal>
          {
            copy.faq.items.map((item, index) => (
              <details name="faq" open={index === 0}>
                <summary>
                  <h3>{item.question}</h3>
                  <span class="home-faq__mark" aria-hidden="true" />
                </summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section class="lp-cta" aria-labelledby="cta-heading" data-reveal>
        <div class="lp-cta__flock" aria-hidden="true">
          <Rook hue="azul" size={64} seed={1} react />
          <Rook hue="laranja" size={76} seed={2} react />
          <Rook hue="menta" size={104} seed={3} float react />
          <Rook hue="violeta" size={76} seed={4} react />
          <Rook hue="rosa" size={64} seed={5} react />
        </div>
        <h2 id="cta-heading" class="lp-title lp-title--cta">{copy.cta.heading}</h2>
        <p class="lp-lead">{copy.cta.copy}</p>
        <a class="button button--primary" href={DOWNLOAD_URL} target="_blank" rel="noopener" data-attr="cta-download">
          {copy.cta.download}
        </a>
      </section>
    </main>

    <Footer locale={locale} homeHref={homeHref} />
  </div>
</BaseLayout>

<script>
  // Blocks below the fold rise once as they arrive. Hidden only after JS runs, so nothing is lost without it.
  const calm = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (calm && "IntersectionObserver" in window) {
    document.documentElement.classList.add("js-reveal");
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
    );
    document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));
  }

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const target = document.querySelector(button.dataset.copy ?? "");
      if (!target?.textContent) return;
      try {
        await navigator.clipboard.writeText(target.textContent);
      } catch {
        return;
      }
      const label = button.textContent;
      button.textContent = button.dataset.copied ?? label;
      setTimeout(() => (button.textContent = label), 1600);
    });
  });
</script>
