{
  "name": "@corvo/api",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./partner-tools": "./src/partner-console/agent-tools.ts"
  },
  "scripts": {
    "dev": "node ../../scripts/dev-watch.mjs src/index.ts",
    "build": "node ../../scripts/build-server.mjs src/index.ts src/cli/migrate-database.ts src/cli/bootstrap-owner.ts src/cli/shared-storage.ts src/cli/partner.ts",
    "start": "node --enable-source-maps dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/api/src",
    "db:migrate": "tsx src/cli/migrate-database.ts",
    "db:deploy": "node --enable-source-maps dist/cli/migrate-database.js",
    "secrets:infisical": "tsx src/cli/secrets-infisical.ts",
    "content-encryption": "tsx src/cli/content-encryption.ts",
    "home-storage": "tsx src/cli/home-storage.ts",
    "shared-storage": "tsx src/cli/shared-storage.ts",
    "partner": "tsx src/cli/partner.ts",
    "partner:demo": "tsx src/cli/partner-demo.ts",
    "partner:embed-demo": "tsx src/cli/partner-embed-demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@orpc/server": "1.15.7",
    "@corvo/adapter-kit": "workspace:*",
    "@corvo/adapters": "workspace:*",
    "@corvo/auth": "workspace:*",
    "@corvo/contracts": "workspace:*",
    "@corvo/core": "workspace:*",
    "@corvo/db": "workspace:*",
    "@corvo/logging": "workspace:*",
    "@corvo/memory": "workspace:*",
    "hono": "4.13.14",
    "mermaid": "11.17.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
