{
  "name": "@corvo/desktop",
  "productName": "Corvo",
  "version": "0.1.34",
  "author": {
    "name": "Rook"
  },
  "homepage": "https://rook.team",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "pnpm check && node scripts/build.mjs && node scripts/copy-static.mjs && node scripts/build-engine.mjs",
    "pack": "pnpm --filter @corvo/web build && pnpm build && electron-builder --mac",
    "pack:dir": "pnpm --filter @corvo/web build && pnpm build && electron-builder --dir",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "release": "pnpm --filter @corvo/web build && pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@corvo/contracts": "workspace:*",
    "@corvo/logging": "workspace:*",
    "@sentry/electron": "8.3.0",
    "electron-updater": "6.8.11",
    "koffi": "3.3.4",
    "jsdom": "30.1.3",
    "sherpa-onnx-node": "2.0.1",
    "@whiskeysockets/baileys": "6.7.24"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@corvo/adapters": "workspace:*",
    "@corvo/ui-tokens": "workspace:*",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "tech.corvo.bots.desktop",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/@embedded-postgres/**"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../infra/sandboxes/computer",
        "to": "computer",
        "filter": [
          "**/*",
          "!test_*.py",
          "!*.d.ts"
        ]
      }
    ],
    "extraMetadata": {
      "name": "corvo",
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "x64ArchFiles": "{**/node_modules/@koromix/koffi-darwin-*/darwin_*/koffi.node,**/node_modules/@oxc-parser/binding-darwin-*/parser.darwin-*.node,**/node_modules/sherpa-onnx-darwin-*/**,**/node_modules/@img/sharp-darwin-*/**,**/node_modules/@img/sharp-libvips-darwin-*/**}",
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDisplayName": "Rook",
        "NSMicrophoneUsageDescription": "Rook uses the microphone for dictation and voice calls with your bots."
      },
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": true,
      "artifactName": "corvo-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "node_modules/@embedded-postgres/darwin-arm64/native",
          "to": "postgres",
          "filter": [
            "bin/**",
            "lib/**",
            "share/**"
          ]
        }
      ]
    },
    "dmg": {
      "title": "${productName}",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 175,
          "type": "file"
        },
        {
          "x": 490,
          "y": 175,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true,
      "artifactName": "corvo-win-${arch}.${ext}",
      "extraResources": [
        {
          "from": "node_modules/@embedded-postgres/windows-${arch}/native",
          "to": "postgres",
          "filter": [
            "bin/**",
            "lib/**",
            "share/**"
          ]
        }
      ]
    },
    "linux": {
      "executableName": "corvo",
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "synopsis": "Rook, your team of AI agents",
      "description": "Rook runs a team of AI agents on your computer with its own local database.",
      "maintainer": "Rook <support@rook.team>",
      "category": "Utility",
      "artifactName": "corvo-linux-${arch}.${ext}",
      "extraResources": [
        {
          "from": "node_modules/@embedded-postgres/linux-${arch}/native",
          "to": "postgres",
          "filter": [
            "bin/**",
            "lib/**",
            "share/**"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "corvo-technology",
        "repo": "rook"
      }
    ]
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "18.4.0-beta.17",
    "@embedded-postgres/linux-arm64": "18.4.0-beta.17",
    "@embedded-postgres/linux-x64": "18.4.0-beta.17",
    "@embedded-postgres/windows-x64": "18.4.0-beta.17"
  }
}
