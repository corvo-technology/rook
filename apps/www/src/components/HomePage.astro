---
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import GuideSlot from "./GuideSlot.astro";
import Avatar from "./Avatar.astro";
import Piece from "./Piece.astro";
import { MASCOT_COLOR } from "../mascot";
import { Rook } from "./Rook";
import { ProductPreview } from "./ProductPreview";
import { AGENT_CATALOG } from "@corvo/core";
import type { StoreCategory } from "../i18n/launch";
import type { Locale } from "../i18n/locales";
import { getLaunchCopy } from "../i18n/launch";
import { DEFAULT_LOCALE, LOCALE_HTML_LANG, isLocale, localeHomePath } from "../i18n/locales";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  DOWNLOAD_URL,
  DOWNLOAD_URL_LINUX,
  DOWNLOAD_URL_LINUX_ARM64,
  DOWNLOAD_URL_LINUX_ARM64_DEB,
  DOWNLOAD_URL_LINUX_DEB,
  DOWNLOAD_URL_WINDOWS,
  INSTALL_COMMAND,
  INSTALL_COMMAND_WINDOWS,
  SITE_URL,
  WAITLIST_ENDPOINT,
} from "../site";
import { homeStructuredData } from "../structured-data";
import "../styles/launch.css";

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;

const copy = getLaunchCopy(locale);
const homeHref = localeHomePath(locale);
const pageUrl = `${SITE_URL}${homeHref === "/" ? "/" : homeHref}`;

const structuredData = homeStructuredData({
  pageUrl,
  title: copy.meta.title,
  description: copy.meta.description,
  inLanguage: LOCALE_HTML_LANG[locale],
  faq: copy.faq.items,
});

// Social images exist for these languages; the others borrow the English one until theirs is drawn.
const OG_LOCALES: readonly Locale[] = ["pt", "es", "fr", "de", "ja", "zh"];
const ogImage = OG_LOCALES.includes(locale) ? `/og-image-${locale}.png` : "/og-image.png";

const { works } = copy;

// The Store's agents come from the product's own catalog, so the page says what is there.
const catalogLocale = locale === "pt" ? "pt-BR" : "en";
const CATEGORY_ORDER: StoreCategory[] = ["finance", "operations", "marketing", "support"];
const storeGroups = CATEGORY_ORDER.map((category) => ({
  category,
  names: AGENT_CATALOG.filter((entry) => entry.category === category)
    .slice(0, 3)
    .map((entry) => entry.name[catalogLocale] ?? entry.name.en),
}));
// Brand names, the same in every language.
const MODEL_CHIPS = ["Claude", "ChatGPT", "OpenRouter"];
// The four states an agent is in, the same ones the app shows on its rooks.
const STATES = [
  { mood: "working", hue: "azul" },
  { mood: "asking", hue: "laranja" },
  { mood: "sleeping", hue: "neutro" },
  { mood: "done", hue: "menta" },
] as const;
const [featureCards, plainItems] = [works.cards.slice(0, 3), works.cards.slice(3)];
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  {structuredData}
  locale={locale}
  skipLabel={copy.meta.skipToContent}
  homeAlternates
  ogImageAlt={copy.meta.ogImageAlt}
  ogImage={ogImage}
>
  <div class="container">
    <Header locale={locale} copy={copy.nav} homeHref={homeHref} />

    <main id="main">
      <section class="lp-hero">
        <p class="lp-hero__pill">{copy.hero.pill}</p>
        <h1>
          <span>{copy.hero.line1}</span>
          <GuideSlot class="guide-slot--inline" />
          <span>{copy.hero.line2}</span>
        </h1>
        <p class="lp-hero__lead">{copy.hero.lead[0]}<br />{copy.hero.lead[1]}</p>
        <div class="lp-hero__actions">
          <span class="lp-hero__cta">
            <a class="button button--primary" href="#waitlist" data-attr="hero-waitlist">
              {copy.hero.join}
            </a>
          </span>
          <a class="button button--secondary" href={DOWNLOAD_URL} target="_blank" rel="noopener" data-attr="hero-download">
            {copy.cta.download}
          </a>
          <p class="download-note">
            {
              copy.hero.note.split(/(\{windows\}|\{linux\})/).map((part) =>
                part === "{windows}" ? (
                  <a href={DOWNLOAD_URL_WINDOWS} data-attr="hero-download-windows">Windows</a>
                ) : part === "{linux}" ? (
                  <a href={DOWNLOAD_URL_LINUX} data-attr="hero-download-linux">Linux</a>
                ) : (
                  part
                ),
              )
            }
          </p>
        </div>
        <div class="lp-hero__demo">
          <ProductPreview copy={copy.preview} client:visible={{ rootMargin: "300px" }} />
        </div>
      </section>

      <section id="agents" class="lp-agent" aria-labelledby="agent-heading">
        <GuideSlot row class="guide-slot--perch guide-slot--mid" />
        <Piece piece="queen" hue="azul" class="guide-piece--mid" />
        <div class="lp-center" data-reveal>
          <h2 id="agent-heading" class="lp-title">{copy.agent.accent}</h2>
          <p class="lp-lead">{copy.agent.copy}</p>
        </div>
        <ul class="lp-states" data-reveal>
          {
            STATES.map((state, index) => (
              <li>
                <button type="button" class="state">
                  <Rook hue={state.hue} size={56} mood={state.mood} seed={index + 6} gaze={false} ring={state.mood === "working"} still />
                  <span>{copy.agent.states[state.mood]}</span>
                </button>
              </li>
            ))
          }
        </ul>
        <ul class="lp-traits" data-reveal>
          {
            copy.agent.traits.map((trait) => (
              <li>
                <h3>{trait.title}</h3>
                <p>{trait.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="store" class="lp-store" aria-labelledby="store-heading">
        <GuideSlot row class="guide-slot--perch guide-slot--start" />
        <Piece piece="pawn" hue="violeta" class="guide-piece--start" />
        <div class="lp-store__intro" data-reveal>
          <h2 id="store-heading" class="lp-title">{copy.store.accent}</h2>
          <p class="lp-lead">{copy.store.copy}</p>
        </div>
        <div class="lp-rows" data-reveal>
          {
            storeGroups.map((group) => (
              <div class="lp-store__row">
                <h3>{copy.store.categories[group.category]}</h3>
                <ul>
                  {group.names.map((name) => (
                    <li>{name}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section id="features" class="lp-works" aria-labelledby="works-heading">
        <GuideSlot row class="guide-slot--perch guide-slot--mid" />
        <Piece piece="knight" hue="rosa" class="guide-piece--mid" />
        <h2 id="works-heading" class="lp-title lp-title--center" data-reveal>
          {works.heading}
          <br />
          {works.accent}
        </h2>
        <div class="lp-cards" data-reveal>
          <article class="lp-card">
            <h3>{featureCards[0]!.title}</h3>
            <p>{featureCards[0]!.body}</p>
            <ul class="lp-routines">
              {
                works.routines.slice(0, 3).map((routine) => (
                  <li>
                    <time>{routine.when}</time>
                    <span>{routine.what}</span>
                  </li>
                ))
              }
            </ul>
          </article>
          <article class="lp-card">
            <h3>{featureCards[1]!.title}</h3>
            <p>{featureCards[1]!.body}</p>
            <div class="lp-term" role="img" aria-label={works.computer.title}>
              {works.computer.lines.map((line) => <code data-ok={line.startsWith("✓") ? "" : undefined}>{line}</code>)}
            </div>
          </article>
          <article class="lp-card">
            <h3>{featureCards[2]!.title}</h3>
            <p>{featureCards[2]!.body}</p>
            <ul class="lp-chips">
              {MODEL_CHIPS.map((name) => <li>{name}</li>)}
              <li>{works.models.local}</li>
            </ul>
          </article>
        </div>
        <ul class="lp-items" data-reveal>
          {
            plainItems.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="business" class="lp-open" aria-labelledby="business-heading">
        <GuideSlot row class="guide-slot--perch guide-slot--start" />
        <Piece piece="king" hue="vermelho" class="guide-piece--start" />
        <div class="lp-open__intro" data-reveal>
          <h2 id="business-heading" class="lp-title">{copy.business.heading}</h2>
        </div>
        <ul class="lp-rows lp-points" data-reveal>
          {
            copy.business.points.map((point) => (
              <li>
                <h3>{point.title}</h3>
                <p>{point.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="runs" class="lp-open" aria-labelledby="runs-heading">
        <GuideSlot row class="guide-slot--perch guide-slot--start" />
        <Piece piece="bishop" hue="laranja" class="guide-piece--start" />
        <div class="lp-open__intro" data-reveal>
          <h2 id="runs-heading" class="lp-title">{copy.runs.heading} {copy.runs.accent}</h2>
          <p class="lp-lead">{copy.runs.copy}</p>
        </div>
        <ul class="lp-rows lp-points" data-reveal>
          {
            copy.runs.points.map((point) => (
              <li>
                <h3>{point.title}</h3>
                <p>{point.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="install" class="lp-install" aria-labelledby="install-heading">
        <h2 id="install-heading" class="lp-title lp-title--center" data-reveal>{copy.install.heading}</h2>
        <div class="lp-paths" data-reveal>
          <article id="waitlist" class="lp-card lp-wait ink">
            <span class="lp-wait__badge">{copy.waitlist.badge}</span>
            <h3>{copy.waitlist.title}</h3>
            <p>{copy.waitlist.copy}</p>
            <form
              class="lp-wait__form"
              novalidate
              data-waitlist={WAITLIST_ENDPOINT}
              data-locale={locale}
              data-success={copy.waitlist.success}
              data-email-error={copy.waitlist.emailError}
              data-company-error={copy.waitlist.companyError}
              data-error={copy.waitlist.error}
            >
              <label>
                <span>{copy.waitlist.email}</span>
                <input type="email" name="email" required autocomplete="email" />
                <small data-error-for="email" role="alert"></small>
              </label>
              <label>
                <span>{copy.waitlist.company}</span>
                <input type="text" name="company" required autocomplete="organization" />
                <small data-error-for="company" role="alert"></small>
              </label>
              <label>
                <span>{copy.waitlist.task}</span>
                <textarea name="task" rows="3"></textarea>
              </label>
              <div class="lp-wait__trap" aria-hidden="true">
                <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
              </div>
              <button type="submit" class="button button--primary" data-attr="waitlist-submit">{copy.cta.waitlist}</button>
              <p class="lp-wait__error" data-form-error role="alert" hidden></p>
            </form>
            <div class="lp-wait__done" data-waitlist-done aria-live="polite" hidden>
              <strong>{copy.waitlist.successTitle}</strong>
              <p data-done-body></p>
            </div>
          </article>
          <article class="lp-card">
            <h3>{copy.install.local.title}</h3>
            <p>{copy.install.local.copy}</p>
            <a class="button button--secondary" href={DOWNLOAD_URL} target="_blank" rel="noopener" data-attr="install-download">
              {copy.install.download}
            </a>
            <p class="download-note lp-formats">
              {copy.install.formats.label}:{" "}
              <a href={DOWNLOAD_URL} data-attr="install-format-mac">{copy.install.formats.mac}&nbsp;(.dmg)</a>{" · "}
              <a href={DOWNLOAD_URL} data-attr="install-format-mac-intel">{copy.install.formats.macIntel}&nbsp;(.dmg)</a>{" · "}
              <a href={DOWNLOAD_URL_LINUX_DEB} data-attr="install-format-deb">{copy.install.formats.linux}&nbsp;.deb</a>{" · "}
              <a href={DOWNLOAD_URL_LINUX} data-attr="install-format-appimage">{copy.install.formats.linux}&nbsp;AppImage</a>{" · "}
              {copy.install.formats.arm64}:{" "}
              <a href={DOWNLOAD_URL_LINUX_ARM64_DEB} data-attr="install-format-arm64-deb">.deb</a>{" · "}
              <a href={DOWNLOAD_URL_LINUX_ARM64} data-attr="install-format-arm64-appimage">AppImage</a>{" · "}
              <a href={DOWNLOAD_URL_WINDOWS} data-attr="install-format-windows">{copy.install.formats.windows}&nbsp;(.exe)</a>
            </p>
          </article>
        </div>
        <div class="lp-commands" data-reveal>
          <div class="lp-command">
            <span>{copy.install.macLinux}</span>
            <code id="install-unix">{INSTALL_COMMAND}</code>
            <button type="button" data-copy="#install-unix" data-copied={copy.install.copiedLabel}>
              {copy.install.copyLabel}
            </button>
          </div>
          <div class="lp-command">
            <span>{copy.install.windows}</span>
            <code id="install-windows">{INSTALL_COMMAND_WINDOWS}</code>
            <button type="button" data-copy="#install-windows" data-copied={copy.install.copiedLabel}>
              {copy.install.copyLabel}
            </button>
          </div>
          <p class="download-note">{copy.install.note}</p>
        </div>
        <p class="lp-migrate" data-reveal>{copy.install.migrate}</p>
      </section>

      <section id="faq" class="lp-faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="lp-title" data-reveal>{copy.faq.heading}</h2>
        <div class="home-faq" data-reveal>
          {
            copy.faq.items.map((item, index) => (
              <details name="faq" open={index === 0}>
                <summary>
                  <h3>{item.question}</h3>
                  <span class="home-faq__mark" aria-hidden="true" />
                </summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section class="lp-cta ink ink-band" aria-labelledby="cta-heading" data-guide-gone>
        <h2 id="cta-heading" class="lp-title lp-title--cta">{copy.cta.heading}</h2>
        <p class="lp-lead">{copy.cta.copy}</p>
        <div class="lp-cta__actions">
          <a class="button button--primary" href="#waitlist" data-attr="cta-waitlist">
            {copy.cta.waitlist}
          </a>
          <a class="button button--secondary" href={DOWNLOAD_URL} target="_blank" rel="noopener" data-attr="cta-download">
            {copy.cta.download}
          </a>
        </div>
        <div class="lp-cta__peek">
          <p class="lp-cta__bubble lp-cta__bubble--left">{copy.cta.bubbles[0]}</p>
          <Avatar color={MASCOT_COLOR.menta} mood="happy" class="lp-cta__rook" mate />
          <p class="lp-cta__bubble lp-cta__bubble--right">{copy.cta.bubbles[1]}</p>
        </div>
      </section>
    </main>

    <Footer locale={locale} homeHref={homeHref} />
  </div>
  <div class="rook-guide" data-guide aria-hidden="true">
    <Avatar color={MASCOT_COLOR.menta} />
  </div>
</BaseLayout>

<script>
  import "../guide";

  // Blocks below the fold rise once as they arrive. Everything is visible until the first scroll: only then
  // are the blocks still below the fold hidden, so a page that is never scrolled (a crawler, a preview, a
  // full-page screenshot) shows it all.
  const calm = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (calm && "IntersectionObserver" in window) {
    const first = new AbortController();
    const arm = () => {
      first.abort();
      document.documentElement.classList.add("js-reveal");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-in");
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => {
        if (el.getBoundingClientRect().top < window.innerHeight) return;
        el.setAttribute("data-armed", "");
        observer.observe(el);
      });
    };
    for (const type of ["scroll", "wheel", "touchmove", "keydown"]) {
      window.addEventListener(type, arm, { passive: true, signal: first.signal });
    }
  }

  const waitlist = document.querySelector<HTMLFormElement>("form[data-waitlist]");
  if (waitlist) {
    const field = (name: string) => waitlist.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
    const fail = (name: string, message: string) => {
      const input = field(name);
      waitlist.querySelector<HTMLElement>(`[data-error-for="${name}"]`)!.textContent = message;
      input.setAttribute("aria-invalid", message ? "true" : "false");
    };
    waitlist.addEventListener("submit", async (event) => {
      event.preventDefault();
      const email = field("email").value.trim();
      const company = field("company").value.trim();
      const badEmail = !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      fail("email", badEmail ? (waitlist.dataset.emailError ?? "") : "");
      fail("company", company ? "" : (waitlist.dataset.companyError ?? ""));
      const problem = waitlist.querySelector<HTMLElement>('[aria-invalid="true"]');
      if (problem) return problem.focus();
      const button = waitlist.querySelector<HTMLButtonElement>("button[type=submit]")!;
      const failure = waitlist.querySelector<HTMLElement>("[data-form-error]")!;
      failure.hidden = true;
      button.disabled = true;
      try {
        const response = await fetch(waitlist.dataset.waitlist ?? "", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            email,
            company,
            task: field("task").value.trim(),
            locale: waitlist.dataset.locale,
            website: field("website").value,
          }),
        });
        if (!response.ok) throw new Error(String(response.status));
        const done = waitlist.parentElement!.querySelector<HTMLElement>("[data-waitlist-done]")!;
        done.querySelector("[data-done-body]")!.textContent = (waitlist.dataset.success ?? "")
          .replace("{email}", email)
          .replace("{company}", company);
        waitlist.hidden = true;
        done.hidden = false;
      } catch {
        failure.textContent = waitlist.dataset.error ?? "";
        failure.hidden = false;
        button.disabled = false;
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const target = document.querySelector(button.dataset.copy ?? "");
      if (!target?.textContent) return;
      try {
        await navigator.clipboard.writeText(target.textContent);
      } catch {
        return;
      }
      const label = button.textContent;
      button.textContent = button.dataset.copied ?? label;
      setTimeout(() => (button.textContent = label), 1600);
    });
  });
</script>
