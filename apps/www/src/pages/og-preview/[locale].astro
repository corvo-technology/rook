---
import type { GetStaticPaths } from "astro";
import { Rook } from "../../components/Rook";
import { getLaunchCopy } from "../../i18n/launch";
import { LOCALES, LOCALE_HTML_LANG, isLocale } from "../../i18n/locales";

// The social image is drawn here and captured by scripts/generate-og.mjs, so it reads the same
// headline as the page. The route exists only in dev; production builds skip it.
export const getStaticPaths = (() =>
  import.meta.env.DEV ? LOCALES.map((locale) => ({ params: { locale } })) : []) satisfies GetStaticPaths;

const { locale } = Astro.params;
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`);

const copy = getLaunchCopy(locale);
const { line1, line2, lead } = copy.hero;
// The headline steps down for the longer languages so it stays on one line.
const length = line1.length + line2.length;
const cjk = locale === "ja" || locale === "zh";
const size = cjk ? 84 : length <= 16 ? 110 : length <= 22 ? 96 : 84;
---

<html lang={LOCALE_HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Rook social image</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;500&family=Inter:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main id="og" style={`--size:${size}px`}>
      <header>
        <Rook hue="menta" size={44} />
        <span>Rook</span>
      </header>
      <h1>
        <span>{line1}</span>
        <Rook hue="menta" size={size * 1.17} />
        <span>{line2}</span>
      </h1>
      <p>{lead[0]} {lead[1]}</p>
      <small>{copy.meta.ogTagline}</small>
    </main>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    background: #0a0a0a;
  }
  #og {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: #0a0a0a;
    color: #f4f4f5;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans", sans-serif;
  }
  #og .rook {
    display: block;
    flex: none;
    overflow: visible;
  }
  #og .rook__body {
    fill: var(--rook);
  }
  #og .rook__eyes,
  #og .rook__eyes ellipse {
    fill: #0a0a0a;
  }
  #og header {
    position: absolute;
    top: 48px;
    left: 64px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: "Inter Tight", sans-serif;
    font-size: 28px;
    font-weight: 500;
  }
  #og h1 {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 0;
    font-family: "Inter Tight", sans-serif;
    font-size: var(--size);
    font-weight: 300;
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
  }
  #og p {
    margin: 0;
    color: #a3a3aa;
    font-size: 30px;
    text-align: center;
  }
  #og small {
    position: absolute;
    bottom: 44px;
    color: #8d8d94;
    font-size: 22px;
  }
</style>
