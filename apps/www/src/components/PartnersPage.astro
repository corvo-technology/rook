---
import { COUNTRY_CODES, callingCode, exampleNumber } from "@corvo/core/phone";
import { LOCALES, LOCALE_HTML_LANG } from "../i18n/locales";
import type { Locale } from "../i18n/locales";
import { getLaunchCopy } from "../i18n/launch";
import { getPartnersCopy } from "../i18n/partners";
import BaseLayout from "../layouts/BaseLayout.astro";
import { PARTNER_LEADS_ENDPOINT } from "../site";
import "../styles/launch.css";
import "../styles/partners.css";
import Button from "./Button.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { Rook } from "./Rook";

type Props = { locale: Locale };

const { locale } = Astro.props;
const copy = getPartnersCopy(locale);
const launch = getLaunchCopy(locale);
const alternates = Object.fromEntries(LOCALES.map((l) => [l, `${getPartnersCopy(l).path}/`]));
const form = copy.form;
const FORM_STEPS = 3;
const DEFAULT_COUNTRY: Record<Locale, string> = { en: "US", pt: "BR", es: "ES", fr: "FR", de: "DE", ja: "JP", zh: "CN" };
const countryNames = new Intl.DisplayNames([LOCALE_HTML_LANG[locale]], { type: "region" });
const countries = COUNTRY_CODES.map((code) => ({ code, name: countryNames.of(code) ?? code })).sort((a, b) =>
  a.name.localeCompare(b.name, LOCALE_HTML_LANG[locale]),
);
const HEROES = ["menta", "azul", "laranja", "violeta", "vermelho"] as const;
const NAV = [
  { section: "como", hue: "menta", label: copy.nav.how },
  { section: "ganhos", hue: "azul", label: copy.nav.earn },
  { section: "plataforma", hue: "violeta", label: copy.nav.platform },
  { section: "perguntas", hue: "rosa", label: copy.nav.faq },
] as const;
// Made-up bars for the console, from the oldest month to the newest.
const BARS = [22, 30, 38, 47, 58, 70, 86];
const RANGES = ["0-50", "50-200", "200-1000", "1000+"] as const;
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  locale={locale}
  skipLabel={launch.meta.skipToContent}
  localeAlternates={false}
  pageAlternates={alternates}
  ogImageAlt={launch.meta.ogImageAlt}
>
  <div class="container">
    <Header locale={locale} copy={launch.nav} links={[...NAV]} cta={{ href: "#inscricao", label: copy.nav.cta }} />

    <main id="main" lang={LOCALE_HTML_LANG[locale]} class="partners">
      <section class="lp-hero partners-hero">
        <p class="lp-hero__pill">{copy.hero.pill}</p>
        <h1>{copy.hero.title}</h1>
        <p class="lp-hero__lead">{copy.hero.lead}</p>
        <div class="lp-hero__actions">
          <Button href="#inscricao" data-attr="partners-cta">{copy.hero.cta}</Button>
        </div>
        <p class="partners-note">{copy.hero.scarcity}</p>
        <div class="partners-rooks" aria-hidden="true">
          {HEROES.map((hue, index) => <Rook hue={hue} size={40} seed={index} />)}
        </div>
      </section>

      <section class="partners-band" aria-label={copy.preview.console}>
        <div class="partners-console ink" role="img" aria-label={copy.preview.caption}>
          <aside>
            <strong>{copy.preview.company}</strong>
            <span>{copy.preview.console}</span>
            <ul>
              {copy.preview.menu.map((item, index) => <li aria-current={index === 0 ? "true" : undefined}>{item}</li>)}
            </ul>
          </aside>
          <div class="partners-console__main">
            <div class="partners-console__head">
              <div>
                <strong>{copy.preview.greeting}</strong>
                <span>{copy.preview.month}</span>
              </div>
              <span class="partners-console__add">{copy.preview.add}</span>
            </div>
            <div class="partners-console__metrics">
              {
                copy.preview.metrics.map((label, index) => (
                  <div data-tone={index === 2 ? "warn" : index === 3 ? "good" : undefined}>
                    <span>{label}</span>
                    <strong>{index === 0 ? "R$ —" : "—"}</strong>
                  </div>
                ))
              }
            </div>
            <div class="partners-console__panels">
              <div>
                <span>{copy.preview.chart}</span>
                <div class="partners-console__bars">
                  {BARS.map((height, index) => <i style={`--h: ${height}%`} data-last={index === BARS.length - 1 ? "" : undefined} />)}
                </div>
              </div>
              <div>
                <span>{copy.preview.queue}</span>
                <ul>
                  {copy.preview.items.map((item) => <li><span>{item.text}</span><b>{item.action}</b></li>)}
                </ul>
              </div>
            </div>
          </div>
        </div>
        <p class="partners-caption">{copy.preview.caption}</p>
      </section>

      <section class="partners-section partners-two" aria-labelledby="pain-heading">
        <h2 id="pain-heading" class="lp-title" data-reveal>{copy.pain.heading}</h2>
        <div class="partners-two__body" data-reveal>
          {copy.pain.paragraphs.map((text) => <p>{text}</p>)}
        </div>
      </section>

      <section id="como" class="partners-section" aria-labelledby="how-heading">
        <h2 id="how-heading" class="lp-title" data-reveal>{copy.how.heading}</h2>
        <ol class="partners-steps" data-reveal>
          {
            copy.how.steps.map((step, index) => (
              <li class:list={[index === copy.how.steps.length - 1 && "ink"]}>
                <span>{index + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="ganhos" class="partners-earn ink ink-band" aria-labelledby="earn-heading">
        <h2 id="earn-heading" class="lp-title" data-reveal>{copy.earn.heading}</h2>
        <div class="partners-cards partners-cards--earn" data-reveal>
          {
            copy.earn.cards.map((card, index) => (
              <article class="lp-card" data-accent={index === 2 ? "" : undefined}>
                <h3>{card.title}</h3>
                <p>
                  {index === 1 && <b class="partners-soon">{copy.earn.soon}</b>}
                  {card.body}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="partners-section" aria-labelledby="billing-heading">
        <div class="partners-head" data-reveal>
          <h2 id="billing-heading" class="lp-title">{copy.billing.heading}</h2>
          <p class="lp-lead">{copy.billing.lead}</p>
        </div>
        <div class="partners-cards partners-cards--dense partners-cards--pair" data-reveal>
          {
            copy.billing.items.map((item) => (
              <article class="lp-card">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="partners-section" aria-labelledby="central-heading">
        <div class="partners-head" data-reveal>
          <h2 id="central-heading" class="lp-title">{copy.central.heading}</h2>
          <p class="lp-lead">{copy.central.lead}</p>
        </div>
        <div class="partners-cards partners-cards--dense" data-reveal>
          {
            copy.central.items.map((item) => (
              <article class="lp-card">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="partners-section" aria-labelledby="benefits-heading">
        <h2 id="benefits-heading" class="lp-title" data-reveal>{copy.benefits.heading}</h2>
        <div class="partners-cards" data-reveal>
          {
            copy.benefits.items.map((item) => (
              <article class="lp-card">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="partners-section" aria-labelledby="split-heading">
        <div class="partners-head" data-reveal>
          <h2 id="split-heading" class="lp-title">
            {copy.split.heading.split("\n").map((line, index) => (index === 0 ? line : [<br />, line]))}
          </h2>
          <p class="lp-lead">{copy.split.lead}</p>
        </div>
        <div class="partners-sides" data-reveal>
          <article class="lp-card">
            <h3>{copy.split.you.title}</h3>
            <ul class="partners-checks">{copy.split.you.items.map((item) => <li>{item}</li>)}</ul>
          </article>
          <article class="lp-card" data-accent="">
            <h3>{copy.split.us.title}</h3>
            <ul class="partners-checks">{copy.split.us.items.map((item) => <li>{item}</li>)}</ul>
          </article>
        </div>
      </section>

      <section id="plataforma" class="partners-section" aria-labelledby="platform-heading">
        <div class="partners-head" data-reveal>
          <h2 id="platform-heading" class="lp-title">{copy.platform.heading}</h2>
          <p class="lp-lead">{copy.platform.lead}</p>
        </div>
        <div class="partners-cards partners-cards--dense" data-reveal>
          {
            copy.platform.items.map((item, index) => (
              <article class="lp-card" data-accent={index === copy.platform.items.length - 1 ? "" : undefined}>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="partners-section" aria-labelledby="who-heading">
        <h2 id="who-heading" class="lp-title" data-reveal>{copy.who.heading}</h2>
        <ul class="partners-checks partners-checks--ruled" data-reveal>
          {copy.who.items.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section id="inscricao" class="partners-section partners-contact" aria-labelledby="cohort-heading">
        <div class="partners-contact__intro" data-reveal>
          <h2 id="cohort-heading" class="lp-title">{copy.cohort.heading}</h2>
          <p class="lp-lead">{copy.cohort.lead}</p>
          <ul class="partners-checks">{copy.cohort.perks.map((perk) => <li>{perk}</li>)}</ul>
        </div>
        <article class="lp-card lp-wait ink partners-form-card" data-reveal>
          <div class="partners-form-card__head">
            <h3>{form.title}</h3>
            <p>{form.hint}</p>
          </div>
          <form
            class="lp-wait__form partners-form"
            novalidate
            data-partner-form={PARTNER_LEADS_ENDPOINT}
            data-locale={locale}
            data-steps={FORM_STEPS}
            data-progress={form.progress}
            data-next={form.next}
            data-submit={form.submit}
            data-success={form.success}
            data-required-error={form.requiredError}
            data-email-error={form.emailError}
            data-phone-error={form.phoneError}
            data-keep-country={locale === "pt" ? "" : undefined}
            data-consent-error={form.consentError}
            data-error={form.error}
          >
            <div class="partners-progress">
              <span data-progress-label>{form.progress.replace("{n}", "1").replace("{total}", String(FORM_STEPS))}</span>
              <div aria-hidden="true"><i data-progress-bar style={`width: ${100 / FORM_STEPS}%`}></i></div>
            </div>
            <div class="partners-step" data-step="1">
              <label>
                <span>{form.name}</span>
                <input type="text" name="name" required maxlength="120" autocomplete="name" placeholder={form.placeholders.name} />
                <small data-error-for="name" role="alert"></small>
              </label>
              <label>
                <span>{form.email}</span>
                <input type="email" name="email" required maxlength="254" autocomplete="email" placeholder={form.placeholders.email} />
                <small data-error-for="email" role="alert"></small>
              </label>
              <label>
                <span>{form.country}</span>
                <select name="country" autocomplete="country">
                  {countries.map(({ code, name }) => <option value={code} selected={code === DEFAULT_COUNTRY[locale]}>{name}</option>)}
                </select>
              </label>
              <label>
                <span>{form.whatsapp}</span>
                <div class="partners-phone">
                  <span data-dial aria-hidden="true">+{callingCode(DEFAULT_COUNTRY[locale])}</span>
                  <input type="tel" name="whatsapp" maxlength="24" autocomplete="tel-national" inputmode="tel" placeholder={exampleNumber(DEFAULT_COUNTRY[locale])} />
                </div>
                <small data-error-for="whatsapp" role="alert"></small>
              </label>
              <label>
                <span>{form.company}</span>
                <input type="text" name="company" required maxlength="120" autocomplete="organization" placeholder={form.placeholders.company} />
                <small data-error-for="company" role="alert"></small>
              </label>
              <label>
                <span>{form.website}</span>
                <input type="text" name="website" maxlength="300" autocomplete="url" placeholder={form.placeholders.website} />
              </label>
            </div>
            <div class="partners-step" data-step="2" hidden>
              <label>
                <span>{form.type}</span>
                <select name="partnerType">
                  <option value="embedded">{form.types.embedded}</option>
                  <option value="white_label">{form.types.white_label}</option>
                  <option value="unsure" selected>{form.types.unsure}</option>
                </select>
              </label>
              <label>
                <span>{form.customers}</span>
                <select name="customers">
                  <option value=""></option>
                  {RANGES.map((value, index) => <option value={value}>{form.customerRanges[index]}</option>)}
                </select>
              </label>
            </div>
            <div class="partners-step" data-step="3" hidden>
              <label>
                <span>{form.message}</span>
                <textarea name="message" rows="4" maxlength="2000" placeholder={form.placeholders.message}></textarea>
              </label>
              <label class="partners-consent">
                <input type="checkbox" name="consent" required />
                <span>{form.consent}</span>
              </label>
              <small data-error-for="consent" role="alert"></small>
            </div>
            <div class="lp-wait__trap" aria-hidden="true">
              <label>Website <input type="text" name="hp" tabindex="-1" autocomplete="off" /></label>
            </div>
            <div class="partners-actions">
              <button type="button" class="button button--secondary" data-back hidden>{form.back}</button>
              <button type="submit" class="button button--primary" data-attr="partners-submit">{form.next}</button>
            </div>
            <p class="lp-wait__error" data-form-error role="alert" hidden></p>
          </form>
          <div class="lp-wait__done" data-partner-done aria-live="polite" hidden tabindex="-1">
            <strong>{form.successTitle}</strong>
            <p data-done-body></p>
          </div>
        </article>
      </section>

      <section id="perguntas" class="lp-faq partners-faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="lp-title" data-reveal>{copy.faq.heading}</h2>
        <div class="home-faq" data-reveal>
          {
            copy.faq.items.map((item, index) => (
              <details name="partners-faq" open={index === 0}>
                <summary>
                  <h3>{item.question}</h3>
                  <span class="home-faq__mark" aria-hidden="true" />
                </summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section class="lp-cta partners-cta ink ink-band" aria-labelledby="cta-heading">
        <h2 id="cta-heading" class="lp-title lp-title--cta">{copy.cta.heading}</h2>
        <Button href="#inscricao" data-attr="partners-closing">{copy.cta.button}</Button>
      </section>
    </main>

    <Footer locale={locale} />
  </div>
</BaseLayout>

<script>
  import { callingCode, exampleNumber, formatNational, isCountryCode, isValidNational, toE164 } from "@corvo/core/phone";

  // Blocks below the fold rise once as they arrive. Everything stays visible until the first scroll.
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    const first = new AbortController();
    const arm = () => {
      first.abort();
      document.documentElement.classList.add("js-reveal");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-in");
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => {
        if (el.getBoundingClientRect().top < window.innerHeight) return;
        el.setAttribute("data-armed", "");
        observer.observe(el);
      });
    };
    for (const type of ["scroll", "wheel", "touchmove", "keydown"]) {
      window.addEventListener(type, arm, { passive: true, signal: first.signal });
    }
  }

  const root = document.querySelector<HTMLFormElement>("form[data-partner-form]");
  if (root) {
    const form = root;
    const control = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const steps = [...form.querySelectorAll<HTMLElement>("[data-step]")];
    const back = form.querySelector<HTMLButtonElement>("[data-back]")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const label = form.querySelector<HTMLElement>("[data-progress-label]")!;
    const bar = form.querySelector<HTMLElement>("[data-progress-bar]")!;
    const failure = form.querySelector<HTMLElement>("[data-form-error]")!;
    const { requiredError = "", emailError = "", phoneError = "", consentError = "" } = form.dataset;
    const country = form.elements.namedItem("country") as HTMLSelectElement;
    const phone = control("whatsapp");
    const dial = form.querySelector<HTMLElement>("[data-dial]")!;
    let current = 0;

    const value = (name: string) => control(name).value.trim();
    const fail = (name: string, message: string) => {
      form.querySelector<HTMLElement>(`[data-error-for="${name}"]`)!.textContent = message;
      control(name).setAttribute("aria-invalid", message ? "true" : "false");
    };
    // The prefix and the layout follow the country; the browser's region wins over the page language.
    const layout = () => {
      dial.textContent = `+${callingCode(country.value) ?? ""}`;
      phone.placeholder = exampleNumber(country.value);
      phone.value = formatNational(country.value, phone.value);
    };
    const region = [...navigator.languages]
      .map((tag) => {
        try {
          return new Intl.Locale(tag).region;
        } catch {
          return undefined;
        }
      })
      .find((code) => code && isCountryCode(code));
    if (region && form.dataset.keepCountry === undefined) country.value = region;
    country.addEventListener("change", layout);
    phone.addEventListener("input", () => {
      phone.value = formatNational(country.value, phone.value);
      fail("whatsapp", "");
    });
    layout();
    // Each step checks only its own fields; the first bad one takes focus.
    const check: Array<() => void> = [
      () => {
        fail("name", value("name") ? "" : requiredError);
        fail("email", /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value("email")) ? "" : emailError);
        fail("whatsapp", !value("whatsapp") || isValidNational(country.value, value("whatsapp")) ? "" : phoneError);
        fail("company", value("company") ? "" : requiredError);
      },
      () => {},
      () => fail("consent", control("consent").checked ? "" : consentError),
    ];
    const show = (index: number, focus = true) => {
      current = index;
      steps.forEach((step, i) => (step.hidden = i !== index));
      back.hidden = index === 0;
      button.textContent = (index === steps.length - 1 ? form.dataset.submit : form.dataset.next) ?? "";
      label.textContent = (form.dataset.progress ?? "")
        .replace("{n}", String(index + 1))
        .replace("{total}", String(steps.length));
      bar.style.width = `${((index + 1) / steps.length) * 100}%`;
      if (focus) steps[index]!.querySelector<HTMLElement>("input, select, textarea")?.focus();
    };
    const invalid = () => steps[current]!.querySelector<HTMLElement>('[aria-invalid="true"]');
    back.addEventListener("click", () => show(current - 1));

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      check[current]!();
      const bad = invalid();
      if (bad) return bad.focus();
      if (current < steps.length - 1) return show(current + 1);
      failure.hidden = true;
      button.disabled = true;
      try {
        const response = await fetch(form.dataset.partnerForm ?? "", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            name: value("name"),
            email: value("email"),
            whatsapp: toE164(country.value, value("whatsapp")) ?? "",
            company: value("company"),
            website: value("website"),
            partnerType: value("partnerType"),
            country: country.value,
            customers: value("customers") || undefined,
            message: value("message"),
            consent: true,
            locale: form.dataset.locale,
            source: "www-partners",
            hp: control("hp").value,
          }),
        });
        if (response.status !== 200) throw new Error(String(response.status));
        const done = form.parentElement!.querySelector<HTMLElement>("[data-partner-done]")!;
        done.querySelector("[data-done-body]")!.textContent = (form.dataset.success ?? "").replace(
          "{email}",
          value("email"),
        );
        form.hidden = true;
        done.hidden = false;
        done.focus();
      } catch {
        failure.textContent = form.dataset.error ?? "";
        failure.hidden = false;
        button.disabled = false;
      }
    });
    // Without a script the three steps all show; with it, one at a time.
    show(0, false);
  }
</script>
