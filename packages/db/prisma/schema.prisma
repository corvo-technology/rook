generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AiDataConsent {
  userId       String
  spaceId      String
  recipientKey String
  version      String
  grantedAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  space        Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceMember  SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)

  @@id([userId, spaceId, recipientKey])
  @@map("ai_data_consents")
}

model User {
  aiDataConsents              AiDataConsent[]
  ownedPartnerTenants         PartnerTenant[]
  partner                     Partner?
  id                          String                          @id
  name                        String
  email                       String
  emailVerified               Boolean                         @default(false)
  image                       String?
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
  avatarStyle                 String                          @default("organic")
  /// IANA timezone such as "Pacific/Auckland". Null until set; bots then get UTC only.
  timezone                    String?
  sessions                    Session[]
  accounts                    Account[]
  passkeys                    Passkey[]
  userMemories                UserMemory[]
  members                     Member[]
  invitations                 Invitation[]
  modelCredentials            UserModelCredential[]
  voiceCredentials            UserVoiceCredential[]
  secrets                     Secret[]
  mcpServers                  McpServer[]
  botSections                 BotSection[]
  actionApprovalRules         ActionApprovalRule[]
  actionAutoReviewPreferences ActionAutoReviewPreference[]
  modelRoleChoices            UserModelRoleChoice[]
  modelPreferences            UserModelPreference[]
  voicePreferences            UserVoicePreference[]
  approvalRules               UserActionApprovalRule[]
  autoReviewPreference        UserActionAutoReviewPreference?
  createdSpaces               Space[]                         @relation("SpaceCreator")
  invitationsSent             SpaceInvitation[]               @relation("SpaceInvitationInviter")
  joinRequests                SpaceJoinRequest[]              @relation("SpaceJoinRequester")
  inviteLinksMade             SpaceInviteLink[]               @relation("SpaceInviteLinkCreator")
  botSecrets                  BotSecret[]
  agentSecrets                AgentSecret[]
  createdTickets              Ticket[]                        @relation("TicketCreatorUser")
  ticketComments              TicketComment[]                 @relation("TicketCommentAuthorUser")
  pushToken                   PushToken?
  signupSurvey                SignupSurvey?
  coachTour                   CoachTour?
  computerRuns                ComputerRun[]
  messagingInstallations      MessagingInstallation[]
  messagingInstallSessions    MessagingInstallSession[]

  @@unique([email])
  @@map("user")
}

/// A row with no answers means the user skipped the survey.
model SignupSurvey {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?
  use       String?
  teamSize  String?
  source    String?
  createdAt DateTime @default(now())

  @@map("signup_surveys")
}

/// A person's coach tour progress. No row means the tour has not started (a new account).
model CoachTour {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  done      String[] @default([])
  skipped   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("coach_tours")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

/// One current device registration per account, matching the notification API contract.
/// No session FK: password changes delete a session before the replacement is created.
model PushToken {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ciphertext  String
  tokenDigest String   @unique
  sessionId   String
  /// The app language of the device, so a push is worded in it.
  locale      String?
  updatedAt   DateTime @updatedAt

  @@map("push_tokens")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Better Auth WebAuthn credentials. `publicKey` is the base64 COSE key.
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@unique([credentialID])
  @@index([userId])
  @@map("passkey")
}

/// Better Auth credential rate limits. `lastRequest` is epoch milliseconds.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Organization {
  id            String              @id
  name          String
  slug          String
  logo          String?
  createdAt     DateTime
  metadata      String?
  members       Member[]
  invitations   Invitation[]
  spaces        Space[]
  billing       BillingAccount?
  modelCredits  ModelCreditAccount?
  partnerTenant PartnerTenant?

  @@unique([slug])
  @@map("organization")
}

model BillingAccount {
  organizationId      String       @id
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId          String       @unique
  creditAmountCents   Int?
  subscriptionId      String?
  subscriptionItemId  String?
  priceId             String?
  status              String?
  seats               Int?
  trialEndsAt         DateTime?
  currentPeriodEndsAt DateTime?
  cancelAtPeriodEnd   Boolean      @default(false)
  endedAt             DateTime?
  subscribedAt        DateTime?
  syncedAt            DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("billing_accounts")
}

model ActionApprovalRule {
  id              String   @id @default(cuid())
  spaceId         String
  space           Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  effect          String
  matchKind       String
  matchValue      String
  createdAt       DateTime @default(now())

  @@unique([spaceId, createdByUserId, effect, matchKind, matchValue])
  @@index([spaceId, createdByUserId])
  @@map("action_approval_rules")
}

model ActionAutoReviewPreference {
  id            String   @id @default(cuid())
  spaceId       String
  space         Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled       Boolean  @default(false)
  skipApprovals Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([spaceId, userId])
  @@map("action_auto_review_preferences")
}

model Member {
  id               String        @id
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String
  createdAt        DateTime
  spaceMemberships SpaceMember[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Space {
  aiDataConsents              AiDataConsent[]
  id                          String                       @id
  organizationId              String
  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                        String
  isDefault                   Boolean                      @default(false)
  createdByUserId             String?
  createdByUser               User?                        @relation("SpaceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt                   DateTime                     @default(now())
  deletingAt                  DateTime?
  /// When the owner paused every bot in the space; null means running.
  pausedAt                    DateTime?
  deletionClaimId             String?
  memberships                 SpaceMember[]
  bots                        Bot[]
  botSections                 BotSection[]
  botDeletions                BotDeletion[]
  threads                     Thread[]
  events                      Event[]
  tasks                       Task[]
  runs                        Run[]
  routines                    Routine[]
  scratchpadItems             ScratchpadItem[]
  taughtSkills                TaughtSkill[]
  agentSkills                 AgentSkill[]
  agentImports                AgentImport[]
  connections                 Connection[]
  capabilities                CapabilityInstall[]
  memoryDocuments             MemoryDocument[]
  agentHomes                  AgentHome[]
  browserProfiles             BrowserProfile[]
  artifacts                   Artifact[]
  notificationPreferences     NotificationPreference[]
  computers                   Computer[]
  computerRuns                ComputerRun[]
  externalEffects             ExternalEffect[]
  mcpServers                  McpServer[]
  mcpOAuthSessions            McpOAuthSession[]
  modelOAuthSessions          ModelOAuthSession[]
  providerQuotas              ProviderQuota[]
  missionStates               MissionState[]
  wikiSettings                WikiSettings?
  wikiSources                 WikiSource[]
  artifactTranscripts         ArtifactTranscript[]
  wikiChanges                 WikiChange[]
  wikiImports                 WikiImport[]
  userMemories                UserMemory[]
  botMcpServers               BotMcpServer[]
  messagingIdentities         MessagingIdentity[]
  actionApprovalRules         ActionApprovalRule[]
  actionAutoReviewPreferences ActionAutoReviewPreference[]
  memoryConfig                SpaceMemoryConfig?
  secrets                     Secret[]
  chatGroups                  ChatGroup[]
  botSecrets                  BotSecret[]
  externalConversations       ExternalConversation[]
  agentSecrets                AgentSecret[]
  board                       Board?
  tickets                     Ticket[]
  ticketComments              TicketComment[]
  messagingInstallations      MessagingInstallation[]
  messagingInstallSessions    MessagingInstallSession[]
  invitations                 SpaceInvitation[]
  inviteLinks                 SpaceInviteLink[]
  joinRequests                SpaceJoinRequest[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([createdByUserId])
  @@map("spaces")
}

/// A space's data encryption key, wrapped by a master key. There is no foreign key:
/// keys are created on their own connection, possibly before the space row commits.
/// A trigger deletes them with the space, which crypto-shreds anything left behind.
model SpaceKey {
  id          String   @id
  spaceId     String
  version     Int
  masterKeyId String
  wrappedKey  String
  createdAt   DateTime @default(now())

  @@unique([spaceId, version])
  @@index([masterKeyId])
  @@map("space_keys")
}

model SpaceMember {
  id               String                 @id
  spaceId          String
  organizationId   String
  space            Space                  @relation(fields: [spaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  userId           String
  member           Member                 @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  role             String                 @default("member")
  /// Whether the memory model suggests facts from what this member says.
  memoryLearning   Boolean                @default(false)
  createdAt        DateTime
  modelPreferences SpaceModelPreference[]
  voicePreferences SpaceVoicePreference[]
  aiDataConsents   AiDataConsent[]
  modelRoleChoices SpaceModelRoleChoice[]
  settingOverrides SpaceSettingOverride[]
  modelConnections SpaceModelConnection[]
  modelSetting     SpaceMemberModelSetting?

  @@unique([spaceId, userId])
  @@index([organizationId, userId])
  @@index([userId, createdAt])
  @@map("space_members")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

/// An invitation to one Space for one address. The link token is an HMAC of `id` under a server
/// secret, so nothing secret is stored and the same link can be sent again.
model SpaceInvitation {
  id           String    @id
  spaceId      String
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// Lowercased address the invitation is bound to.
  email        String
  role         String    @default("member")
  /// pending, accepted or cancelled; an expired pending invitation is simply past `expiresAt`.
  status       String    @default("pending")
  expiresAt    DateTime
  inviterId    String
  inviter      User      @relation("SpaceInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  acceptedById String?
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([spaceId, status])
  @@index([email, status])
  @@map("space_invitations")
}

/// A workspace link that only lets people ask to join. At most one is active per Space.
model SpaceInviteLink {
  id          String    @id
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("SpaceInviteLinkCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([spaceId, revokedAt])
  @@map("space_invite_links")
}

/// Someone who used the invite link and waits for an admin. A denied row stays so asking again
/// changes nothing and the person is never told.
model SpaceJoinRequest {
  id          String    @id
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("SpaceJoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  /// pending, approved or denied.
  status      String    @default("pending")
  reason      String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([spaceId, userId])
  @@index([spaceId, status])
  @@index([userId, status])
  @@map("space_join_requests")
}

model DeploymentSettings {
  modelCreditsEnabled             Boolean  @default(false)
  id                              String   @id @default("default")
  /// Deprecated: retained for rolling-release compatibility; never authorizes app users.
  ownerUserId                     String?
  signupsEnabled                  Boolean  @default(true)
  signupAllowlist                 String   @default("")
  signupPolicyInitialized         Boolean  @default(false)
  defaultModelProvider            String?
  defaultModelId                  String?
  deploymentModelCredentialCipher String?
  computerHost                    String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@map("deployment_settings")
}

/// Append-only security audit trail. No foreign keys, so an account deletion
/// keeps the record of what happened; retention pruning is the only delete.
/// Never stores message content, secrets, or tokens.
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  spaceId   String?
  ip        String?
  userAgent String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([ip, createdAt])
  @@index([userId, createdAt])
  @@map("security_events")
}

model UserModelCredential {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String
  label           String
  secretId        String
  supportsImages  Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  preferences     SpaceModelPreference[]
  roleChoices     SpaceModelRoleChoice[]
  userPreferences UserModelPreference[]
  userRoleChoices UserModelRoleChoice[]

  @@unique([id, userId])
  @@index([userId, provider, updatedAt])
  @@map("user_model_credentials")
}

model UserVoiceCredential {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String
  secretId        String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  preferences     SpaceVoicePreference[]
  userPreferences UserVoicePreference[]

  @@unique([id, userId])
  @@index([userId, provider, updatedAt])
  @@map("user_voice_credentials")
}

model SpaceModelPreference {
  id            String              @id @default(cuid())
  spaceId       String
  userId        String
  spaceMember   SpaceMember         @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  credentialId  String
  credential    UserModelCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)
  modelId       String?
  thinkingLevel String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([spaceId, userId, credentialId])
  @@index([credentialId])
  @@map("space_model_preferences")
}

model SpaceVoicePreference {
  id           String              @id @default(cuid())
  spaceId      String
  userId       String
  spaceMember  SpaceMember         @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  credentialId String
  credential   UserVoiceCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)
  voiceId      String              @default("")
  // Fish speech-model override. Null keeps the deployment default.
  speechModel  String?
  isDefault    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([spaceId, userId, credentialId])
  @@index([spaceId, userId, isDefault, updatedAt])
  @@index([credentialId])
  // Partial unique index space_voice_preferences_default_key is created in SQL.
  @@map("space_voice_preferences")
}

model Bot {
  screenGeneration         Int               @default(0)
  id                       String            @id @default(cuid())
  spaceId                  String
  space                    Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId                   String
  name                     String
  title                    String            @default("")
  description              String            @default("")
  instructions             String            @default("")
  selfUpdateInstructions   Boolean           @default(false)
  instructionHistory       Json              @default("[]")
  pendingInstructionsRunId String?
  color                    String
  notifyOnFinish           Boolean           @default(true)
  pinned                   Boolean           @default(false)
  position                 Int               @default(0)
  sectionId                String?
  section                  BotSection?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  archivedAt               DateTime?
  parentBotId              String?
  spawnKey                 String?
  /// Short first messages shown as buttons while the chat is empty: ["Show today's bookings", ...].
  starters                 Json?
  memoryScope              String?
  parent                   Bot?              @relation("BotChildren", fields: [parentBotId], references: [id], onDelete: SetNull)
  children                 Bot[]             @relation("BotChildren")
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  thread                   Thread?
  computerId               String?
  computer                 Computer?         @relation(fields: [computerId], references: [id], onDelete: SetNull)
  computerSwitching        Boolean           @default(false)
  voiceId                  String?
  autoSpeak                Boolean           @default(false)
  modelProvider            String?
  modelId                  String?
  thinkingLevel            String?
  disabledBuiltinTools     String[]          @default([])
  webhookSecretId          String?
  teamChatAmbientEnabled   Boolean           @default(false)
  teamChatRules            String            @default("")
  crossSpaceCommunication  Boolean           @default(false)
  fleetManagement          Boolean           @default(true)
  squadRouting             Boolean           @default(false)
  /// This bot's own approval mode (never, auto, ask); null follows the member's default.
  approvalMode             String?
  /// Most a bot may spend on hosted model credits in a UTC day; null means no limit.
  dailyCapMicros           BigInt?
  /// Tokens the bot may use in a UTC month; null (or 0) means no limit.
  monthlyTokenLimit        BigInt?
  /// The UTC month ("2026-11") the 80% warning was last sent for.
  budgetAlertMonth         String?
  /// What this bot does with facts about the person: "auto" saves them (with Undo), "ask" waits for Save, "read" only reads. Null is "ask".
  memoryMode               String?
  routines                 Routine[]
  routineSteps             RoutineStep[]
  scratchpadItems          ScratchpadItem[]
  taughtSkills             TaughtSkill[]
  memoryDocuments          MemoryDocument[]
  agentHome                AgentHome?
  browserProfile           BrowserProfile?
  artifacts                Artifact[]
  tasks                    Task[]
  runs                     Run[]
  steeringMessages         SteeringMessage[]
  mcpServers               BotMcpServer[]
  agentImports             AgentImport[]
  groupMembers             ChatGroupMember[]
  botSecrets               BotSecret[]
  assignedTickets          Ticket[]          @relation("TicketAssigneeBot")
  createdTickets           Ticket[]          @relation("TicketCreatorBot")
  ticketComments           TicketComment[]   @relation("TicketCommentAuthorBot")

  externalConversations    ExternalConversation[]
  messagingInstallations   MessagingInstallation[]
  messagingInstallSessions MessagingInstallSession[]

  @@unique([spaceId, spawnKey])
  @@index([spaceId, userId, archivedAt, pinned, updatedAt])
  @@index([sectionId])
  @@index([computerId])
  @@index([parentBotId])
  @@map("bots")
}

model BotSection {
  id        String      @id @default(cuid())
  spaceId   String
  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  bots      Bot[]
  groups    ChatGroup[]

  @@unique([spaceId, userId, name])
  @@index([spaceId, userId, position, createdAt])
  @@map("bot_sections")
}

model BotDeletion {
  id                String   @id
  spaceId           String
  space             Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name              String
  deletedByUserId   String
  memoriesPreserved Boolean
  deletedAt         DateTime @default(now())

  @@index([spaceId, deletedAt])
  @@map("bot_deletions")
}

model ChatGroup {
  id         String            @id @default(cuid())
  spaceId    String
  space      Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  purpose    String?
  pinned     Boolean           @default(false)
  sectionId  String?
  section    BotSection?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  members    ChatGroupMember[]
  thread     Thread?
  artifacts  Artifact[]

  @@index([spaceId, userId, archivedAt, pinned, updatedAt])
  @@index([sectionId])
  @@map("chat_groups")
}

model ChatGroupMember {
  id        String    @id @default(cuid())
  groupId   String
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: NoAction)
  createdAt DateTime  @default(now())

  @@unique([groupId, botId])
  @@index([botId])
  @@map("chat_group_members")
}

model Thread {
  id                             String                @id @default(cuid())
  spaceId                        String
  space                          Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                          String?               @unique
  bot                            Bot?                  @relation(fields: [botId], references: [id], onDelete: Cascade)
  groupId                        String?               @unique
  group                          ChatGroup?            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  externalConversationId         String?               @unique
  externalConversation           ExternalConversation? @relation(fields: [externalConversationId], references: [id], onDelete: Cascade)
  userId                         String
  createdAt                      DateTime              @default(now())
  nextEventSeq                   Int                   @default(0)
  nextMessageSeq                 Int                   @default(0)
  historyCompactedUpToSeq        Int?
  historyCompactionSummary       String?               @db.Text
  historyCompactionGeneration    Int                   @default(0)
  /// After a summary came back over the size limit, compaction waits until nextMessageSeq reaches this.
  historyCompactionRetryAfterSeq Int?
  /// The last message seq the wiki curator has read in this conversation.
  wikiCuratedUpToSeq             Int?
  /// The newest message the memory model has read for facts about the person.
  memoryLearnedUpToSeq           Int?
  /// null follows the conversation's kind (channels on, chats with one agent off); true or false is the person's choice.
  wikiCapture                    Boolean?
  unread                         Boolean               @default(false)
  /// Highest message seq the user has read; the "New" divider goes after it. -1 = none read.
  lastReadSeq                    Int                   @default(-1)
  messages                       Message[]
  events                         Event[]
  tasks                          Task[]
  runs                           Run[]
  routines                       Routine[]
  wikiSources                    WikiSource[]

  @@index([spaceId])
  @@map("threads")
}

model Message {
  id                    String            @id @default(cuid())
  threadId              String
  thread                Thread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  seq                   Int
  role                  String
  blocks                Json
  botId                 String?
  replyToMessageId      String?
  replyQuote            String?
  /// The channel message this one is posted under as a thread reply; null for the main column.
  threadRootId          String?
  replyTo               Message?          @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies               Message[]         @relation("MessageReplies")
  runId                 String?
  clientNonce           String?
  /// How a group message that named nobody was routed (strategy, scores, picked ids, reason, error).
  /// Kept for debugging, and to tell a run the router woke from one a mention or a DM started.
  routing               Json?
  /// Blind-index search tokens for the encrypted blocks; NULL until the row is encrypted.
  searchTokens          Int[]
  sourceRuns            Run[]             @relation("RunSourceMessage")
  externalTranscriptFor ExternalMessage?
  steeringMessages      SteeringMessage[]
  createdAt             DateTime          @default(now())

  @@unique([threadId, seq])
  @@unique([threadId, clientNonce])
  @@index([threadId, seq])
  @@index([replyToMessageId])
  @@index([threadRootId])
  @@index([runId, seq])
  @@index([searchTokens], type: Gin)
  @@map("messages")
}

model Event {
