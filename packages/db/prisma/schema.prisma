  bot                     Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId                  String
  thread                  Thread?
  messages                ExternalMessage[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@unique([provider, workspaceId, externalKey])
  @@index([spaceId, botId])
