  @@unique([userId, spaceId, botId, name])
  @@index([botId])
  @@index([spaceId])
  @@map("bot_secrets")
}

model ExternalConversation {
  id                      String            @id @default(cuid())
  provider                String
  workspaceId             String
  externalKey             String
  conversationId          String
  displayName             String?
  participantNames        String[]          @default([])
  teamChatAmbientEnabled  Boolean?
